{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": { "@/lib/api": ["./fixtures/listen-api-types.ts"] }
  },
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "stories/**/*.tsx",
    "components/**/*.tsx",
    "*.spec.ts"
  ]
}
