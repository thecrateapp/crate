{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "chapters/**/*.ts",
    "remotion/**/*.ts",
    "remotion/**/*.tsx"
  ]
}
