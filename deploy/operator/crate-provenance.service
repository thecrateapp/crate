[Unit]
Description=Crate bounded public release provenance publisher
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/crate-operator/assets
ExecStart=/usr/bin/python3 -m deploy.operator.provenance --config /etc/crate-infra/policy.json
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/crate-operator/context/public

[Install]
WantedBy=multi-user.target
