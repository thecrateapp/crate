{
  "instance": "crate-lab",
  "state_directory": "/var/lib/crate-operator",
  "listen_host": "0.0.0.0",
  "listen_port": 8791,
  "poll_seconds": 45,
  "mcp_url": "http://crate-api:8585/mcp",
  "mcp_host": "api.example.com",
  "prometheus_url": "http://crate-prometheus:9090",
  "mcp_token_file": "/run/secrets/operator_mcp_read",
  "api_token_file": "/run/secrets/operator_api",
  "webhook_url": "http://crate-operator:8644/webhooks/crate-operator",
  "webhook_secret_file": "/run/secrets/operator_webhook",
  "webhook_route": "crate-operator",
  "rules": [
    {
      "id": "worker-evidence",
      "subsystem": "import",
      "tool": "get_observability_summary",
      "source_path": ["data", "subsystems", "import", "sources", "worker"]
    },
    {
      "id": "worker-evidence",
      "subsystem": "enrichment",
      "tool": "get_observability_summary",
      "source_path": ["data", "subsystems", "enrichment", "sources", "worker"]
    },
    {
      "id": "worker-evidence",
      "subsystem": "analysis",
      "tool": "get_observability_summary",
      "source_path": ["data", "subsystems", "analysis", "sources", "worker"]
    },
    {
      "id": "worker-evidence",
      "subsystem": "bliss",
      "tool": "get_observability_summary",
      "source_path": ["data", "subsystems", "bliss", "sources", "worker"]
    },
    {
      "id": "worker-evidence",
      "subsystem": "playback",
      "tool": "get_observability_summary",
      "source_path": ["data", "subsystems", "playback", "sources", "worker"]
    },
    {
      "id": "worker-evidence",
      "subsystem": "projector",
      "tool": "get_observability_summary",
      "source_path": ["data", "subsystems", "projector", "sources", "worker"]
    },
    {
      "id": "worker-evidence",
      "subsystem": "federation",
      "tool": "get_observability_summary",
      "source_path": ["data", "subsystems", "federation", "sources", "worker"]
    },
    {
      "id": "worker-evidence",
      "subsystem": "acquisition",
      "tool": "get_observability_summary",
      "source_path": ["data", "subsystems", "acquisition", "sources", "worker"]
    },
    {
      "id": "pending",
      "subsystem": "import",
      "tool": "get_observability_summary",
      "source_path": ["data", "subsystems", "import", "sources", "pending"],
      "field": ["count"],
      "kind": "high",
      "threshold": 100,
      "clear_threshold": 50,
      "critical": 500
    },
    {
      "id": "release-evidence",
      "subsystem": "version",
      "tool": "get_instance_inventory",
      "source_path": ["data", "sources", "release_manifest"]
    },
    {
      "id": "health-score",
      "subsystem": "instance",
      "tool": "get_observability_summary",
      "source_path": ["data", "sources", "health"],
      "field": ["score"],
      "detail_field": ["breaches"],
      "kind": "low",
      "threshold": 70,
      "clear_threshold": 80,
      "critical": 40,
      "fresh_seconds": 300,
      "cooldown_seconds": 1800
    },
    {
      "id": "failed-tasks",
      "subsystem": "tasks",
      "tool": "get_observability_summary",
      "source_path": ["data", "sources", "failed_tasks"],
      "kind": "digest",
      "field": ["rows"],
      "group_field": ["type"],
      "row_fields": ["id", "type", "error_code", "updated_at"],
      "cooldown_seconds": 1800
    },
    {
      "id": "new-releases",
      "subsystem": "library",
      "tool": "get_observability_summary",
      "source_path": ["data", "sources", "new_releases"],
      "kind": "digest",
      "field": ["rows"],
      "row_fields": [
        "id",
        "artist",
        "album",
        "year",
        "release_date",
        "release_type",
        "status"
      ],
      "cooldown_seconds": 3600
    },
    {
      "id": "prometheus",
      "subsystem": "observability",
      "tool": "prometheus_query",
      "arguments": {
        "query": "prometheus-up"
      },
      "source_path": [],
      "enabled": false,
      "kind": "availability"
    },
    {
      "id": "app-scrape-down",
      "subsystem": "observability",
      "tool": "prometheus_query",
      "arguments": {
        "query": "app-scrape-up-min"
      },
      "source_path": [],
      "enabled": false,
      "kind": "low",
      "field": ["value"],
      "threshold": 0,
      "clear_threshold": 1
    },
    {
      "id": "app-scrape-age",
      "subsystem": "observability",
      "tool": "prometheus_query",
      "arguments": {
        "query": "app-scrape-age-max"
      },
      "source_path": [],
      "enabled": false,
      "kind": "high",
      "field": ["value"],
      "threshold": 120,
      "clear_threshold": 60
    },
    {
      "id": "app-sample-limit",
      "subsystem": "observability",
      "tool": "prometheus_query",
      "arguments": {
        "query": "app-sample-limit-hit"
      },
      "source_path": [],
      "enabled": false,
      "kind": "high",
      "field": ["value"],
      "threshold": 1,
      "clear_threshold": 0,
      "cooldown_seconds": 3600
    },
    {
      "id": "queue-depth",
      "subsystem": "queues",
      "tool": "prometheus_query",
      "arguments": {
        "query": "queue-depth-max"
      },
      "source_path": [],
      "enabled": false,
      "kind": "high",
      "field": ["value"],
      "threshold": 500,
      "clear_threshold": 200,
      "critical": 2000
    },
    {
      "id": "queue-wait-p95",
      "subsystem": "queues",
      "tool": "prometheus_query",
      "arguments": {
        "query": "queue-wait-p95-max"
      },
      "source_path": [],
      "enabled": false,
      "kind": "high",
      "field": ["value"],
      "threshold": 600,
      "clear_threshold": 300
    },
    {
      "id": "task-failure-ratio",
      "subsystem": "queues",
      "tool": "prometheus_query",
      "arguments": {
        "query": "task-failure-ratio-max"
      },
      "source_path": [],
      "enabled": false,
      "kind": "high",
      "field": ["value"],
      "threshold": 0.2,
      "clear_threshold": 0.1,
      "critical": 0.5,
      "cooldown_seconds": 1800
    },
    {
      "id": "api-error-ratio",
      "subsystem": "availability",
      "tool": "prometheus_query",
      "arguments": {
        "query": "api-error-ratio"
      },
      "source_path": [],
      "enabled": false,
      "kind": "high",
      "field": ["value"],
      "threshold": 0.05,
      "clear_threshold": 0.02,
      "critical": 0.2
    },
    {
      "id": "api-latency-p95",
      "subsystem": "availability",
      "tool": "prometheus_query",
      "arguments": {
        "query": "api-latency-p95-max"
      },
      "source_path": [],
      "enabled": false,
      "kind": "high",
      "field": ["value"],
      "threshold": 2,
      "clear_threshold": 1
    },
    {
      "id": "stream-latency-p95",
      "subsystem": "availability",
      "tool": "prometheus_query",
      "arguments": {
        "query": "stream-p95-max"
      },
      "source_path": [],
      "enabled": false,
      "kind": "high",
      "field": ["value"],
      "threshold": 3,
      "clear_threshold": 1.5
    },
    {
      "id": "stalls-per-startup",
      "subsystem": "playback",
      "tool": "prometheus_query",
      "arguments": {
        "query": "playback-stalls-per-startup"
      },
      "source_path": [],
      "enabled": false,
      "kind": "high",
      "field": ["value"],
      "threshold": 0.3,
      "clear_threshold": 0.15,
      "cooldown_seconds": 1800
    },
    {
      "id": "startup-p95",
      "subsystem": "playback",
      "tool": "prometheus_query",
      "arguments": {
        "query": "playback-startup-p95-max"
      },
      "source_path": [],
      "enabled": false,
      "kind": "high",
      "field": ["value"],
      "threshold": 5,
      "clear_threshold": 3
    },
    {
      "id": "transcode-failure-ratio",
      "subsystem": "playback",
      "tool": "prometheus_query",
      "arguments": {
        "query": "transcode-failure-ratio-max"
      },
      "source_path": [],
      "enabled": false,
      "kind": "high",
      "field": ["value"],
      "threshold": 0.2,
      "clear_threshold": 0.1,
      "cooldown_seconds": 1800
    },
    {
      "id": "monitoring-status",
      "subsystem": "observability",
      "tool": "get_stack_status",
      "source_path": ["data", "sources", "monitoring"],
      "field": ["status"],
      "kind": "drift",
      "expected": "running",
      "fresh_seconds": 900,
      "enabled": false
    },
    {
      "id": "summary-stalls",
      "subsystem": "playback",
      "tool": "get_playback_quality",
      "source_path": ["data", "sources", "playback"],
      "field": ["stalls_per_startup"],
      "kind": "high",
      "threshold": 0.3,
      "clear_threshold": 0.15,
      "fresh_seconds": 900,
      "cooldown_seconds": 1800,
      "enabled": false
    },
    {
      "id": "errors-critical",
      "subsystem": "error-inbox",
      "tool": "get_error_summary",
      "source_path": ["data", "sources", "inbox"],
      "field": ["critical_open"],
      "detail_field": ["top_critical"],
      "kind": "high",
      "threshold": 1,
      "clear_threshold": 0,
      "fresh_seconds": 900,
      "cooldown_seconds": 3600,
      "enabled": false
    }
  ],
  "human_callback_secret_file": "/run/secrets/operator_human",
  "allowed_operators": ["telegram:123456789"]
}
