{
  "uid": "crate-infra-data",
  "title": "Crate infrastructure \u00b7 PostgreSQL and Redis",
  "schemaVersion": 40,
  "version": 1,
  "editable": false,
  "tags": ["crate", "infrastructure", "shadow"],
