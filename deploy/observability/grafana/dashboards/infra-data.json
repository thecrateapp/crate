  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "title": "PostgreSQL reachable",
      "type": "timeseries",
      "description": "Exporter-level dependency probe. No data is not healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "crate-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up",
          "datasource": {
            "type": "prometheus",
            "uid": "crate-prometheus"
          },
          "legendFormat": "{{instance}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 1
    },
    {
      "title": "PostgreSQL connections by state",
      "type": "timeseries",
      "description": "Database sessions, not the application SQLAlchemy pool.",
      "datasource": {
        "type": "prometheus",
        "uid": "crate-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (pg_stat_activity_count)",
          "datasource": {
            "type": "prometheus",
            "uid": "crate-prometheus"
          },
          "legendFormat": "{{state}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 2
    },
    {
