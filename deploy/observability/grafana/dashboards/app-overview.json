        }
      },
      "id": 6
    },
    {
      "title": "Stream p95 latency",
      "type": "timeseries",
      "description": "95th percentile of stream responses over 5 minutes. Empty without streams.",
      "datasource": {
        "type": "prometheus",
        "uid": "crate-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
