{
}

(local_tls) {
	tls /certs/dev-stack.pem /certs/dev-stack-key.pem
}

(smart_mix_full) {
	@smart_mix_full {
		method GET
		path /api/tracks/by-entity/*/mix-profile
		query detail=full
	}
	handle @smart_mix_full {
		reverse_proxy api:8585
	}
}

(readplane_listen) {
	@readplane_listen {
		method GET
		path /api/cache/events /api/catalog/* /api/favorites /api/federation/remote/streams/* /api/genres /api/genres/* /api/me /api/me/albums /api/me/follows /api/me/follows/* /api/me/history /api/me/home/discovery /api/me/home/discovery-stream /api/me/home/essentials /api/me/home/favorite-artists /api/me/home/hero /api/me/home/mixes /api/me/home/radio-stations /api/me/home/radio-stations/* /api/me/home/recently-played /api/me/home/recommended-tracks /api/me/home/suggested-albums /api/me/likes /api/search /api/albums/* /api/artist-slugs/* /api/artists/* /api/tracks/*
	}
	handle @readplane_listen {
		reverse_proxy readplane:8686 {
			transport http {
				versions 1.1
				keepalive off
			}
		}
	}
}

(auth_api) {
	@auth_api {
		path /api/auth/* /api/setup/*
	}
	handle @auth_api {
		reverse_proxy api:8585
	}
}

(vdj_api) {
	@vdj_auth header_regexp Authorization ^Bearer[[:space:]]+crv_
	handle @vdj_auth {
		reverse_proxy api:8585
	}
}

(public_album_cover_api) {
	@public_album_cover {
		method GET
		path_regexp album_cover ^/api/albums/(?:by-entity/)?[^/]+/cover$
	}
	handle @public_album_cover {
		reverse_proxy api:8585
	}
}

(vdj_album_cover_api) {
	@vdj_album_cover {
		method GET HEAD
		path_regexp vdj_album_cover ^/api/vdj/albums/[0-9]+/cover$
	}
	handle @vdj_album_cover {
		reverse_proxy api:8585
	}
}

(vdj_media_api) {
	@vdj_media {
		method GET HEAD
		path_regexp vdj_media ^/api/vdj/tracks/by-entity/[^/]+/(?:playback|stream)$
	}
	handle @vdj_media {
		reverse_proxy api:8585
	}
}

(api_backend) {
	@api_backend {
		path /api/*
	}
	handle @api_backend {
		reverse_proxy api:8585
	}
}

https://admin.dev.lespedants.org {
	import local_tls
	route {
		import auth_api
		import vdj_api
		import api_backend
		handle {
			reverse_proxy host.docker.internal:5173
		}
	}
}

https://listen.dev.lespedants.org {
	import local_tls
	route {
		import auth_api
		import vdj_api
		import vdj_media_api
		import smart_mix_full
		import readplane_listen
		import api_backend
		handle {
			reverse_proxy host.docker.internal:5174
		}
	}
}

https://cast.dev.lespedants.org {
	import local_tls
	reverse_proxy cast-receiver:80
}

https://docs.dev.cratemusic.app {
	import local_tls
	reverse_proxy host.docker.internal:5175
}

https://reference.dev.cratemusic.app {
	import local_tls
	reverse_proxy host.docker.internal:5177
}

https://www.dev.cratemusic.app {
	import local_tls
	reverse_proxy host.docker.internal:5176
}

https://api.dev.lespedants.org {
	import local_tls
	route {
		import auth_api
		import vdj_api
		import smart_mix_full
		import vdj_album_cover_api
		import vdj_media_api
		import public_album_cover_api
		import readplane_listen
		handle {
			reverse_proxy api:8585
		}
	}
}
