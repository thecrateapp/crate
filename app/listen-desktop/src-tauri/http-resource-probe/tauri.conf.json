{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crate HTTP resource probe",
  "version": "0.1.0",
  "identifier": "app.cratemusic.crate.desktop.http-resource-probe",
  "build": {
    "frontendDist": "../../scripts/http-resource-probe/dist"
  },
  "app": {
    "windows": [
      {
        "label": "http-probe",
        "title": "Crate HTTP resource probe",
        "width": 640,
        "height": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../icons/icon.png"]
  }
}
