{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "http-resource-probe",
  "description": "Allows the isolated HTTP resource probe to call its loopback fixture.",
  "windows": ["http-probe"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://127.0.0.1:*" }]
    }
  ]
}
