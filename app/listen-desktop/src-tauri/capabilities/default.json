{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the Crate desktop window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://**" },
        { "url": "http://localhost/**" },
        { "url": "http://127.0.0.1/**" },
        { "url": "http://[::1]/**" }
      ]
    }
  ]
}
