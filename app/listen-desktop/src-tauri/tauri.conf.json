{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crate",
  "version": "0.1.0",
  "identifier": "app.cratemusic.crate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5178",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "Crate",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/offline-media/**"]
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: http://localhost:* http://127.0.0.1:* http://[::1]:* data: blob:; media-src 'self' asset: http://asset.localhost https: http://localhost:* http://127.0.0.1:* http://[::1]:* blob:; connect-src 'self' asset: http://asset.localhost https: http://localhost:* http://127.0.0.1:* http://[::1]:* wss: ws://localhost:* ws://127.0.0.1:* ws://[::1]:*; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["cratemusic"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Crate",
    "homepage": "https://cratemusic.app",
    "category": "Music",
    "shortDescription": "Crate desktop music player",
    "longDescription": "Desktop client for Crate, the self-hosted music platform.",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/1024x1024.png",
      "icons/icon.png"
    ],
    "windows": {
      "minimumWebview2Version": "111.0.1661.34",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "section": "sound",
        "depends": ["libwebkit2gtk-4.1-0 (>= 2.40.0)"],
        "desktopTemplate": "linux/desktop-template.desktop"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1 >= 2.40.0"],
        "desktopTemplate": "linux/desktop-template.desktop"
      }
    }
  }
}
