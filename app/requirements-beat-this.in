# PyTorch CPU-only, PANNs and Beat This! for the Smart Mix beats and downbeats (SM3-D14),
# installed in the analysis image (Dockerfile, PANNS=on/auto) on top of the worker lock.
# torch and torchaudio are the CPU builds from the PyTorch index, pinned by wheel URL for
# each Linux architecture. torchaudio and torch move together: torchaudio 2.11.1 declares
# torch>=2.11 and Beat This! was checked on it with torch 2.15.0. mido is madmom's runtime
# dependency; the madmom wheel is built in the image and installed without dependencies.
torch @ https://download.pytorch.org/whl/cpu/torch-2.15.0%2Bcpu-cp313-cp313-manylinux_2_28_x86_64.whl ; sys_platform == "linux" and platform_machine == "x86_64"
torch @ https://download.pytorch.org/whl/cpu/torch-2.15.0%2Bcpu-cp313-cp313-manylinux_2_28_aarch64.whl ; sys_platform == "linux" and platform_machine == "aarch64"
panns_inference
beat-this==1.1.0
einops==0.8.2
rotary-embedding-torch==0.9.1
torchaudio @ https://download.pytorch.org/whl/cpu/torchaudio-2.11.1%2Bcpu-py3-none-manylinux_2_28_x86_64.whl ; sys_platform == "linux" and platform_machine == "x86_64"
torchaudio @ https://download.pytorch.org/whl/cpu/torchaudio-2.11.1%2Bcpu-py3-none-manylinux_2_28_aarch64.whl ; sys_platform == "linux" and platform_machine == "aarch64"
mido
