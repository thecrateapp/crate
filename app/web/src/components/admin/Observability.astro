---
import {
  ALERT_STATES,
  FIGURES,
  FIGURES_NOTE,
  GAP,
  GUIDE,
  HEADINGS,
  JOURNEY,
  LEGEND,
  LEGEND_NOTE,
  MCP_TOOLS,
  NEVER,
  NEVER_LABEL,
  PLAYBACK,
  PRODUCT_CROP,
  QOE_EVENT,
  REJECTED,
  RULE,
  STACK_MAP,
  STATES,
  gapSeries,
} from "../../content/admin/observability";
import ScaleFigures from "../architecture/ScaleFigures.astro";
import StackMap from "../viz/StackMap.astro";

const W = 1000;
const H = 220;
const series = gapSeries();
const step = W / GAP.minutes;
const bar = step * 0.56;
const [gapFrom, gapTo] = GAP.gap;
const gapX = gapFrom * step;
const gapW = (gapTo - gapFrom + 1) * step;
const gapAt = `left:${(gapFrom / GAP.minutes) * 100}%`;
const bars = series.flatMap((value, minute) =>
  value === null
    ? []
    : [{ minute, x: minute * step + (step - bar) / 2, height: value * (H - 30) }],
);
const event = JSON.stringify(QOE_EVENT, null, 2);
const number = (index: number) => String(index + 1).padStart(2, "0");
const rules = FIGURES.find((figure) => figure.label === "Recording rules")?.value;
---

<div class="observability">
  <div class="viz-band">
    <StackMap />
  </div>

  <dl class="legend" data-reveal>
    {
      LEGEND.map((item, index) => (
        <div style={`--i:${index}`}>
          <span class:list={["glyph", item.glyph]} aria-hidden="true" />
          <dt class="viz-label">{item.label}</dt>
          <dd>{item.body}</dd>
        </div>
      ))
    }
  </dl>
  <p class="note">{LEGEND_NOTE}</p>

  <section class="block" aria-labelledby="observability-gap">
    <header class="block-head" data-reveal>
      <h3 id="observability-gap" data-enter>{HEADINGS.gap}</h3>
      <p data-enter style="--d:80ms">{HEADINGS.gapLede}</p>
    </header>

    <figure class="gapviz" data-reveal aria-label={GAP.aria}>
      <header class="viz-bar" data-enter>
        <p class="viz-label"><b>{GAP.label}</b> {GAP.meta}</p>
        <p class="viz-label state">
          <span class="partial">{GAP.state}</span> · <span class="sample">{STACK_MAP.sample}</span>
        </p>
      </header>
      <div class="chart">
        <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <pattern id="observability-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <line x1="0" y1="0" x2="0" y2="7" stroke="rgba(251,191,36,.55)" stroke-width="1.25" />
            </pattern>
          </defs>
          <line x1="0" x2={W} y1={H} y2={H} class="zero" />
          <rect class="gap" x={gapX} y="8" width={gapW} height={H - 8} fill="url(#observability-hatch)" />
          <rect class="gap gap-edge" x={gapX} y="8" width={gapW} height={H - 8} />
          {bars.map((b) => <rect class="b" x={b.x} y={H - b.height} width={bar} height={b.height} rx="1.5" style={`--i:${b.minute}`} />)}
        </svg>
        <p class="axis" aria-hidden="true"><span>−60 min</span><span>now</span></p>
        <p class="callout" style={gapAt} aria-hidden="true">{GAP.callout}</p>
      </div>
      <dl class="states">
        {
          STATES.map((state) => (
            <div class:list={{ current: state.key === "partial" }}>
              <dt class="viz-label">
                <span class:list={["key", state.key]} aria-hidden="true" />
                {state.label}
              </dt>
              <dd>{state.body}</dd>
            </div>
          ))
        }
      </dl>
    </figure>
  </section>

  <section class="block" aria-labelledby="observability-journey">
    <header class="block-head" data-reveal>
      <h3 id="observability-journey" data-enter>{HEADINGS.journey}</h3>
    </header>

    <ol class="journey" data-reveal>
      {
        JOURNEY.map((item, index) => (
          <li style={`--i:${index}`}>
            <span class="num" aria-hidden="true">
              {number(index)}
            </span>
            <div class="step">
              <h4>{item.title}</h4>
              <p>{item.body}</p>
              <p class="viz-label tag">{item.tag}</p>
            </div>
            <div class="artifact">
              {item.id === "report" && (
                <pre class="card" aria-label="A playback event as Listen sends it. It carries no track, album or artist identifier."><code>{event}</code></pre>
              )}
              {item.id === "count" && (
                <div class="minutes">
                  <p class="viz-label">
                    <b>1 min</b> buckets · 8 days
                  </p>
                  <div class="cells" aria-hidden="true">
                    {Array.from({ length: 48 }, (_, cell) => (
                      <i class:list={{ off: cell > 33 && cell < 38 }} />
                    ))}
                  </div>
                  <p class="viz-label">24 h duplicate window · 120 events a minute per session</p>
                </div>
              )}
              {item.id === "read" && (
                <div class="read">
                  <dl class="stat">
                    <div>
                      <dt class="viz-label">Start success</dt>
                      <dd>
                        {PLAYBACK.successPercent}
                        <small>%</small>
                      </dd>
                      <p class="viz-label">
                        {PLAYBACK.started} of {PLAYBACK.attempts} attempts · <span class="sample">{STACK_MAP.sample}</span>
                      </p>
                    </div>
                    <div>
                      <dt class="viz-label">Under {PLAYBACK.minimumAttempts} attempts</dt>
                      <dd class="muted">—</dd>
                      <p class="viz-label pending">small sample</p>
                    </div>
                  </dl>
                  <figure class="crop">
                    <figcaption class="viz-bar">
                      <span class="viz-label">
                        <b>{PRODUCT_CROP.label}</b> {PRODUCT_CROP.meta}
                      </span>
                      <span class="viz-label sample">{STACK_MAP.sample}</span>
                    </figcaption>
                    <img
                      src={PRODUCT_CROP.image}
                      width={PRODUCT_CROP.width}
                      height={PRODUCT_CROP.height}
                      alt={PRODUCT_CROP.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                </div>
              )}
              {item.id === "keep" && (
                <div class="rule">
                  <code>{RULE}</code>
                  <p class="viz-label">
                    1 of {rules} recording rules · none fills a gap with zero
                  </p>
                </div>
              )}
              {item.id === "alert" && (
                <div class="alert">
                  <ul class="chips">
                    {ALERT_STATES.map((state) => (
                      <li class={state.tone}>{state.label}</li>
                    ))}
                  </ul>
                  <ul class="chips tools">
                    {MCP_TOOLS.map((tool) => (
                      <li>{tool}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="carry" data-reveal>
    <div>
      <p class="viz-label" data-enter>{NEVER_LABEL}</p>
      <ul class="chips" data-enter style="--d:80ms">{NEVER.map((item) => <li>{item}</li>)}</ul>
    </div>
    <pre class="card term" aria-label={REJECTED.aria} data-enter style="--d:160ms"><code><span class="dim">{REJECTED.request}</span>
{REJECTED.body}
<span class="pending">{REJECTED.status}</span> <span class="dim">{REJECTED.reason}</span></code></pre>
  </div>

  <div class="figures">
    <ScaleFigures figures={FIGURES} note={FIGURES_NOTE} />
  </div>

  <p class="guide-row" data-reveal>
    <a class="u-link guide" href={GUIDE.href} data-enter>
      {GUIDE.label} <span aria-hidden="true">&rarr;</span>
    </a>
  </p>
</div>

<style>
  .legend {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .legend div {
    display: grid;
    grid-template-rows: 36px auto auto;
    align-content: start;
    gap: 8px;
  }

  .legend dd {
    margin: 0;
    color: var(--fg-2);
    font-size: 14px;
    line-height: 1.55;
  }

  .glyph {
    position: relative;
    width: 36px;
    height: 36px;
  }

  .glyph.dome::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 20px;
    border: 1.25px solid var(--cyan-hi);
    border-bottom: 0;
    border-radius: 36px 36px 0 0;
    box-shadow: 0 -6px 18px rgba(6, 182, 212, 0.18);
  }

  .glyph.node::before,
  .glyph.node::after {
    content: "";
    position: absolute;
    bottom: 4px;
    border-radius: 50%;
    border: 1.25px solid rgba(241, 245, 249, 0.45);
  }

  .glyph.node::before {
    left: 0;
    width: 10px;
    height: 10px;
  }

  .glyph.node::after {
    left: 16px;
    width: 20px;
    height: 20px;
    border-color: var(--cyan-hi);
  }

  .glyph.spike::before {
    content: "";
    position: absolute;
    left: 17px;
    bottom: 4px;
    width: 1.5px;
    height: 30px;
    background: linear-gradient(to top, var(--cyan-hi), transparent);
  }

  .glyph.dots::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 6px;
    background: radial-gradient(circle, var(--cyan-hi) 2px, transparent 2.5px) 0 50% / 12px 6px repeat-x;
  }

  .note {
    max-width: 72ch;
    margin: 28px 0 0;
    color: var(--fg-3);
    font-family: var(--mono);
    font-size: 11.5px;
    line-height: 1.6;
  }

  .block {
    margin-top: 14vh;
  }

  .block-head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: end;
    gap: 16px clamp(24px, 5vw, 80px);
    margin-bottom: 5vh;
  }

  .block-head h3 {
    margin: 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .block-head p {
    max-width: 44ch;
    margin: 0;
    color: var(--fg-2);
    font-size: clamp(0.98rem, 1.1vw, 1.08rem);
    line-height: 1.7;
  }

  .gapviz {
    display: grid;
    gap: 22px;
    margin: 0;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .sample,
  .partial,
  .pending {
    color: var(--amber);
  }

  .chart {
    position: relative;
  }

  .chart svg {
    display: block;
    width: 100%;
    height: clamp(160px, 20vw, 280px);
    overflow: visible;
  }

  .zero {
    stroke: rgba(241, 245, 249, 0.22);
    stroke-dasharray: 2 4;
    vector-effect: non-scaling-stroke;
  }

  .b {
    fill: rgba(103, 232, 249, 0.75);
    transform-box: fill-box;
    transform-origin: bottom;
  }

  .gap-edge {
    fill: none;
    stroke: rgba(251, 191, 36, 0.45);
    stroke-dasharray: 4 5;
    vector-effect: non-scaling-stroke;
  }

  .axis {
    display: flex;
    justify-content: space-between;
    margin: 10px 0 0;
    color: var(--fg-3);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
  }

  .callout {
    position: absolute;
    top: 0;
    margin: 0;
    padding: 0 8px;
    color: var(--amber);
    background: var(--bg);
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translateY(-50%);
  }

  :where(html.js) .gapviz .b {
    transform: scaleY(0);
  }

  :where(html.js) .gapviz .gap,
  :where(html.js) .gapviz .callout {
    opacity: 0;
  }

  .gapviz:global(.is-in) .b {
    transform: scaleY(1);
    transition: transform 0.7s var(--spring-snappy) calc(var(--i) * 14ms);
  }

  .gapviz:global(.is-in) .gap,
  .gapviz:global(.is-in) .callout {
    opacity: 1;
    transition: opacity 0.6s var(--ease-snap) 900ms;
  }

  .states {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
    margin: 8px 0 0;
  }

  .states div {
    display: grid;
    align-content: start;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .states .current {
    border-top-color: rgba(251, 191, 36, 0.55);
  }

  .states dt {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--fg);
  }

  .states dd {
    margin: 0;
    color: var(--fg-2);
    font-size: 13.5px;
    line-height: 1.55;
  }

  .key {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 2px;
  }

  .key.available {
    background: rgba(103, 232, 249, 0.75);
  }

  .key.partial {
    border: 1px dashed rgba(251, 191, 36, 0.7);
    background: repeating-linear-gradient(45deg, rgba(251, 191, 36, 0.55) 0 1px, transparent 1px 4px);
  }

  .key.stale {
    background: rgba(241, 245, 249, 0.3);
  }

  .key.empty {
    border: 1px solid rgba(241, 245, 249, 0.45);
  }

  .key.unavailable {
    border: 1px dashed rgba(241, 245, 249, 0.45);
    border-radius: 50%;
  }

  .journey {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .journey > li {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 4fr) minmax(0, 6fr);
    align-items: start;
    gap: 16px clamp(24px, 4vw, 64px);
    padding: 30px 0;
    border-top: 1px solid var(--line);
  }

  .journey > li::before {
    content: "";
    position: absolute;
    left: 13px;
    top: 64px;
    bottom: -30px;
    width: 1px;
    background: linear-gradient(to bottom, rgba(103, 232, 249, 0.45), rgba(103, 232, 249, 0.08));
  }

  .journey > li:last-child::before {
    display: none;
  }

  :global(:where(html.js)) .journey > li {
    opacity: 0;
  }

  .journey:global(.is-in) > li {
    animation: enter-up 0.7s var(--spring-snappy) both;
    animation-delay: calc(var(--i, 0) * 70ms);
  }

  .num {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid rgba(103, 232, 249, 0.45);
    border-radius: 50%;
    color: var(--cyan-hi);
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
  }

  .step h4 {
    margin: 0 0 12px;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .step p {
    max-width: 52ch;
    margin: 0;
    color: var(--fg-2);
    font-size: clamp(0.98rem, 1.1vw, 1.05rem);
    line-height: 1.7;
  }

  .step .tag {
    margin-top: 14px;
    color: var(--fg-3);
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.4;
  }

  .artifact {
    min-width: 0;
  }

  .card {
    margin: 0;
    padding: 16px 20px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #0d0e14;
    color: var(--fg-2);
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 1.7;
    overflow-x: auto;
  }

  .minutes {
    display: grid;
    gap: 12px;
  }

  .minutes p {
    margin: 0;
  }

  .cells {
    display: grid;
    grid-template-columns: repeat(24, minmax(0, 1fr));
    gap: 4px;
  }

  .cells i {
    aspect-ratio: 1;
    border-radius: 3px;
    background: rgba(6, 182, 212, 0.28);
  }

  .cells i.off {
    outline: 1px dashed rgba(251, 191, 36, 0.45);
    outline-offset: -1px;
    background: repeating-linear-gradient(45deg, rgba(251, 191, 36, 0.5) 0 1px, transparent 1px 4px);
  }

  .read {
    display: grid;
    gap: 28px;
  }

  .stat {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
  }

  .stat div {
    display: grid;
    gap: 10px;
  }

  .stat dd {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin: 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2.6rem, 5vw, 4.6rem);
    line-height: 0.85;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }

  .stat small {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 10.5px;
    color: var(--fg-3);
  }

  .stat .muted {
    color: var(--fg-3);
  }

  .stat p {
    margin: 0;
  }

  .crop {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 16px 20px 20px;
    border: 1px solid var(--line);
    border-radius: 14px;
  }

  .crop img {
    display: block;
    width: 100%;
    max-width: 414px;
    height: auto;
  }

  .rule {
    display: grid;
    justify-items: start;
    gap: 12px;
  }

  .rule code {
    max-width: 100%;
    padding: 8px 14px;
    border: 1px solid rgba(103, 232, 249, 0.4);
    border-radius: 999px;
    color: var(--cyan-hi);
    font-family: var(--mono);
    font-size: 12px;
    overflow-wrap: anywhere;
  }

  .rule p {
    margin: 0;
  }

  .alert {
    display: grid;
    gap: 12px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--fg-2);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .chips li.pending {
    border-style: dashed;
    border-color: rgba(251, 191, 36, 0.45);
  }

  .chips li.on {
    border-color: rgba(103, 232, 249, 0.4);
    color: var(--cyan-hi);
  }

  .carry {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 24px clamp(24px, 5vw, 80px);
    margin-top: 12vh;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .carry .chips {
    margin-top: 14px;
  }

  .term .dim {
    color: var(--fg-3);
  }

  .figures {
    margin-top: 10vh;
  }

  .guide-row {
    margin: 6vh 0 0;
  }

  .guide {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 15px;
    color: var(--cyan-hi);
  }

  @media (max-width: 1000px) {
    .legend,
    .states {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .journey > li {
      grid-template-columns: 40px minmax(0, 1fr);
    }

    .artifact {
      grid-column: 2;
    }
  }

  @media (max-width: 760px) {
    .block {
      margin-top: 10vh;
    }

    .block-head,
    .carry {
      grid-template-columns: 1fr;
    }

    .callout {
      font-size: 9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :where(html.js) .gapviz .b {
      transform: none;
    }

    :where(html.js) .gapviz .gap,
    :where(html.js) .gapviz .callout {
      opacity: 1;
    }

    .gapviz:global(.is-in) .b,
    .gapviz:global(.is-in) .gap,
    .gapviz:global(.is-in) .callout {
      transition: none;
    }

    :global(:where(html.js)) .journey > li {
      opacity: 1;
    }

    .journey:global(.is-in) > li {
      animation: none;
    }
  }
</style>
