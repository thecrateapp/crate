---
import { gallery } from "../content/gallery";
import { t } from "../i18n";
import Showcase from "./showcase/Showcase.astro";

interface Props {
  app: "listen" | "admin";
  locale?: string;
}

const { app, locale = "en" } = Astro.props;
---

<Showcase
  shots={gallery.filter((shot) => shot.app === app)}
  label={t(app === "listen" ? "gallery.label.listen" : "gallery.label.admin", locale)}
  position={t("gallery.position", locale)}
  previous={t("gallery.previous", locale)}
  next={t("gallery.next", locale)}
  pause={t("gallery.pause", locale)}
  play={t("gallery.play", locale)}
/>
