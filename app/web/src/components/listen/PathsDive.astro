---
import { t } from "../../i18n";
import type { Step } from "../../lib/chapters";
import { PATH_ROUTE } from "../../scripts/listen/scene";
import DeepDive from "./DeepDive.astro";

interface Props {
  steps: Step[];
  locale?: string;
}

const { steps, locale = "en" } = Astro.props;
---

<DeepDive name="paths" steps={steps}>
  <p class="mono-panel paths-caption" data-fade>
    <b>{t("paths.title", locale)}</b> · {PATH_ROUTE.from} → {PATH_ROUTE.to} ·
    {t("paths.tracks", locale, { tracks: String(PATH_ROUTE.tracks) })}
  </p>
  <p class="mono-panel paths-saved" data-fade>{t("paths.saved", locale)}</p>
</DeepDive>

<style>
  .paths-caption {
    left: 4%;
    bottom: 12%;
  }

  .paths-saved {
    top: 96px;
    left: 4%;
    color: var(--cyan-hi);
  }

  :global([data-dive="paths"] .route) {
    fill: none;
    stroke: var(--cyan-hi);
    stroke-width: 1.25;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 6px rgba(103, 232, 249, 0.6));
    opacity: 0;
  }

  :global([data-dive="paths"] .node) {
    fill: var(--bg);
    stroke: var(--cyan-hi);
    stroke-width: 1.25;
    opacity: 0;
  }

  :global([data-dive="paths"] .node.end) {
    fill: var(--cyan-hi);
  }

  :global([data-dive="paths"] .node-label) {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: pre;
    font-size: 10px;
    line-height: 1.6;
    letter-spacing: 0.08em;
    color: var(--fg-2);
    text-shadow:
      0 0 4px var(--bg),
      0 0 10px var(--bg);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
    pointer-events: none;
  }

  :global([data-dive="paths"] .node-label.is-end) {
    flex-direction: row-reverse;
    translate: calc(-100% + 40px) 0;
    text-align: right;
  }

  :global([data-dive="paths"] .node-cover) {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 3px;
    object-fit: cover;
    box-shadow: 0 0 0 1px rgba(241, 245, 249, 0.12);
  }

  :global([data-dive="paths"] .node-label.is-on) {
    opacity: 1;
  }

  @media (max-width: 760px) {
    .paths-caption {
      left: 0;
      bottom: 4%;
      font-size: 9.5px;
    }
    .paths-saved {
      top: 78px;
      left: 0;
      font-size: 9.5px;
    }
    :global([data-dive="paths"] .node-label) {
      font-size: 9px;
      gap: 8px;
    }
    :global([data-dive="paths"] .node-cover) {
      width: 40px;
      height: 40px;
    }
  }
</style>
