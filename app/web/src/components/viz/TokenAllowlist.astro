---
import { ALLOWLIST, allowlistMatch, PROBES, SCOPES, TOKEN } from "../../content/developers/viz";

const probes = PROBES.map((probe) => ({ ...probe, match: allowlistMatch(probe.method, probe.path) }));
const last = probes[probes.length - 1]!;
const shortPath = (path: string) => path.replace(/[0-9a-f]{8}-[0-9a-f-]{27}/, "203e2dd3…");
---

<figure class="allow" data-viz="allowlist" data-reveal aria-label={`A personal access token reaches only ${ALLOWLIST.length} allowlisted routes. Any other request is treated as signed out.`}>
  <header class="viz-bar" data-enter>
    <p class="viz-label"><b>Personal access token</b> {TOKEN.prefix} · {TOKEN.bytes} random bytes</p>
    <p class="viz-label">stored as a SHA-256 digest</p>
  </header>

  <div class="token" data-enter style="--d:80ms">
    <p class="token-value"><span>{TOKEN.example.slice(0, TOKEN.displayPrefixLength)}</span><span class="rest">{TOKEN.example.slice(TOKEN.displayPrefixLength)}</span></p>
    <ul class="scopes">{SCOPES.map((scope) => <li>{scope}</li>)}</ul>
  </div>

  <div class="probe" aria-live="polite">
    <span class="viz-label">Request</span>
    <code data-probe-request><b>{last.method}</b> {shortPath(last.path)}</code>
    <span class:list={["verdict", last.match >= 0 ? "ok" : "no"]} data-probe-verdict>
      {last.match >= 0 ? "allowed" : "treated as signed out"}
    </span>
  </div>

  <ol class="routes">
    {
      ALLOWLIST.map((route, index) => (
        <li data-route={index} class:list={{ "is-hit": index === last.match }}>
          <span class="methods">
            {route.methods.map((method) => (
              <b class:list={["method", method.toLowerCase()]}>{method}</b>
            ))}
          </span>
          <code>{route.label}</code>
        </li>
      ))
    }
  </ol>
  <script type="application/json" data-probes set:html={JSON.stringify(probes.map((probe) => ({ ...probe, path: shortPath(probe.path) })))} />
</figure>

<style>
  .allow {
    margin: 0;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .token {
    display: grid;
    gap: 14px;
    margin-top: 26px;
  }

  .token-value {
    margin: 0;
    overflow: hidden;
    font-family: var(--mono);
    font-size: clamp(0.95rem, 1.5vw, 1.25rem);
    color: var(--fg);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .token-value .rest {
    color: transparent;
    text-shadow: 0 0 8px rgba(241, 245, 249, 0.45);
  }

  .scopes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .scopes li {
    padding: 4px 10px;
    border: 1px solid rgba(103, 232, 249, 0.4);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--cyan-hi);
  }

  .probe {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
    margin-top: 26px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #0d0e14;
  }

  .probe code {
    overflow: hidden;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--fg);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .probe code b {
    margin-right: 8px;
    font-weight: 400;
    color: var(--cyan-hi);
  }

  .verdict {
    padding: 3px 9px;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .verdict.ok,
  .verdict:global(.ok) {
    border: 1px solid rgba(103, 232, 249, 0.5);
    color: var(--cyan-hi);
  }

  .verdict.no,
  .verdict:global(.no) {
    border: 1px solid rgba(251, 191, 36, 0.5);
    color: var(--amber);
  }

  .routes {
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .routes li {
    display: grid;
    grid-template-columns: 11ch minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    padding: 7px 0 7px 10px;
    border-bottom: 1px solid rgba(241, 245, 249, 0.06);
    border-left: 2px solid transparent;
    transition:
      background-color 0.3s var(--ease-snap),
      border-color 0.3s var(--ease-snap);
  }

  .routes li:global(.is-hit) {
    border-left-color: var(--cyan-hi);
    background: linear-gradient(90deg, rgba(6, 182, 212, 0.1), transparent 75%);
  }

  .routes code {
    overflow: hidden;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--fg-2);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .methods {
    display: flex;
    gap: 4px;
  }

  .method {
    padding: 1px 6px;
    border: 1px solid rgba(103, 232, 249, 0.4);
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 9.5px;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--cyan-hi);
  }

  .method.post {
    border-color: var(--cyan-hi);
    background: var(--cyan-hi);
    color: var(--bg);
  }

  .method.head {
    border-color: var(--line);
    color: var(--fg-2);
  }

  @media (max-width: 760px) {
    .probe {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .probe > .viz-label {
      display: none;
    }
    .routes li {
      grid-template-columns: 9ch minmax(0, 1fr);
    }
  }
</style>
