---
import { DEVICES } from "../../content/listen/viz";

const sub: Record<string, string> = {
  desktop: "native media controls",
  android: "signed release",
  pwa: "offline mirror",
  cast: "send playback",
  subsonic: "Feishin · Symfonium · Subtracks",
};
---

<figure class="devices" data-reveal data-playing aria-label="One library playing the same track on desktop, Android, the web app, Google Cast and Subsonic clients">
  <header class="viz-bar" data-enter>
    <p class="viz-label"><b>Everywhere</b> one library, one queue position</p>
    <p class="viz-label">7 languages · Last.fm · ListenBrainz</p>
  </header>
  <ul class="device-row">
    {
      DEVICES.map((device, index) => (
        <li style={`--i:${index}`} class={`device-${device.id}`}>
          {device.id === "desktop" && (
            <svg viewBox="0 0 260 196" aria-hidden="true">
              <rect class="o" x="1" y="1" width="258" height="160" rx="9" pathLength="1" />
              <path class="o" d="M110 161 L104 190 M150 161 L156 190 M88 194 H172" pathLength="1" />
              <g class="ui">
                <rect class="art" x="22" y="30" width="58" height="58" rx="4" />
                <rect class="t1" x="94" y="40" width="96" height="7" rx="2" />
                <rect class="t2" x="94" y="56" width="64" height="5" rx="2" />
                <circle class="ctl" cx="104" cy="80" r="4" />
                <circle class="ctl main" cx="124" cy="80" r="7" />
                <circle class="ctl" cx="144" cy="80" r="4" />
                <line class="track" x1="22" y1="128" x2="238" y2="128" />
                <line class="prog" x1="22" y1="128" x2="238" y2="128" />
              </g>
            </svg>
          )}
          {(device.id === "android" || device.id === "pwa") && (
            <svg viewBox="0 0 96 196" aria-hidden="true">
              <rect class="o" x="1" y="1" width="94" height="192" rx="16" pathLength="1" />
              {device.id === "android" ? (
                <circle class="o" cx="48" cy="13" r="3" pathLength="1" />
              ) : (
                <rect class="o" x="34" y="9" width="28" height="8" rx="4" pathLength="1" />
              )}
              <g class="ui">
                <rect class="art" x="14" y="38" width="68" height="68" rx="5" />
                <rect class="t1" x="14" y="120" width="54" height="6" rx="2" />
                <rect class="t2" x="14" y="133" width="38" height="5" rx="2" />
                <line class="track" x1="14" y1="156" x2="82" y2="156" />
                <line class="prog" x1="14" y1="156" x2="82" y2="156" />
                <circle class="ctl main" cx="48" cy="174" r="6" />
                {device.id === "pwa" && <circle class="badge" cx="78" cy="30" r="3" />}
              </g>
            </svg>
          )}
          {device.id === "cast" && (
            <svg viewBox="0 0 230 176" aria-hidden="true">
              <rect class="o" x="1" y="1" width="228" height="140" rx="6" pathLength="1" />
              <path class="o" d="M80 150 H150 M115 141 V150" pathLength="1" />
              <g class="ui">
                <rect class="art" x="20" y="24" width="72" height="72" rx="4" />
                <rect class="t1" x="106" y="40" width="88" height="7" rx="2" />
                <rect class="t2" x="106" y="56" width="56" height="5" rx="2" />
                <line class="track" x1="20" y1="118" x2="210" y2="118" />
                <line class="prog" x1="20" y1="118" x2="210" y2="118" />
                <path class="cast" d="M196 20 a12 12 0 0 1 12 12 M196 26 a6 6 0 0 1 6 6 M196 31 v1" />
              </g>
            </svg>
          )}
          {device.id === "subsonic" && (
            <svg viewBox="0 0 150 196" aria-hidden="true">
              <rect class="o" x="1" y="1" width="148" height="192" rx="12" pathLength="1" />
              <g class="ui">
                <rect class="art" x="16" y="20" width="36" height="36" rx="3" />
                <rect class="t1" x="62" y="26" width="64" height="6" rx="2" />
                <rect class="t2" x="62" y="40" width="42" height="5" rx="2" />
                <rect class="row" x="16" y="74" width="118" height="5" rx="2" />
                <rect class="row" x="16" y="90" width="96" height="5" rx="2" />
                <rect class="row" x="16" y="106" width="108" height="5" rx="2" />
                <rect class="row" x="16" y="122" width="84" height="5" rx="2" />
                <line class="track" x1="16" y1="160" x2="134" y2="160" />
                <line class="prog" x1="16" y1="160" x2="134" y2="160" />
              </g>
            </svg>
          )}
          <p class="viz-label">
            <b>{device.label}</b>
            <span>{sub[device.id]}</span>
          </p>
        </li>
      ))
    }
  </ul>
</figure>

<style>
  .devices {
    margin: 0;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .device-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
    margin: 7vh 0 0;
    padding: 0;
    list-style: none;
  }

  .device-row li {
    display: grid;
    justify-items: center;
    gap: 22px;
    min-width: 0;
  }

  svg {
    display: block;
    height: clamp(120px, 15vw, 196px);
    width: auto;
    max-width: 100%;
    overflow: visible;
  }

  .device-cast svg {
    height: clamp(108px, 13.5vw, 176px);
  }

  .o {
    fill: none;
    stroke: rgba(241, 245, 249, 0.55);
    stroke-width: 1.25;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  :global(:where(html.js)) .o {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  :global(:where(html.js)) .is-in .o {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.4s var(--ease-out) calc(var(--i) * 140ms);
  }

  .ui .art {
    fill: rgba(6, 182, 212, 0.16);
    stroke: rgba(103, 232, 249, 0.45);
    vector-effect: non-scaling-stroke;
  }

  .ui .t1 {
    fill: rgba(241, 245, 249, 0.7);
  }

  .ui .t2,
  .ui .row {
    fill: rgba(241, 245, 249, 0.22);
  }

  .ui .ctl {
    fill: none;
    stroke: rgba(241, 245, 249, 0.4);
    vector-effect: non-scaling-stroke;
  }

  .ui .ctl.main {
    fill: var(--cyan-hi);
    stroke: none;
  }

  .ui .track {
    stroke: rgba(241, 245, 249, 0.14);
    stroke-width: 2;
  }

  .ui .prog {
    stroke: var(--cyan-hi);
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: left;
    transform: scaleX(0.38);
  }

  .ui .badge {
    fill: var(--cyan-hi);
  }

  .ui .cast {
    fill: none;
    stroke: var(--cyan-hi);
    stroke-width: 2;
    stroke-linecap: round;
  }

  :global(:where(html.js)) .ui {
    opacity: 0;
  }

  :global(:where(html.js)) .is-in .ui {
    opacity: 1;
    transition: opacity 0.8s var(--ease-out) calc(700ms + var(--i) * 140ms);
  }

  :global(.is-playing) .ui .prog {
    animation: progress 14s linear infinite;
  }

  @keyframes progress {
    from {
      transform: scaleX(0.02);
    }
    to {
      transform: scaleX(1);
    }
  }

  li .viz-label {
    display: grid;
    gap: 4px;
    text-align: center;
  }

  li .viz-label b {
    margin: 0;
    font-weight: 400;
    color: var(--fg);
  }

  @media (max-width: 760px) {
    .device-row {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 36px 16px;
    }
    .device-row li {
      grid-column: span 2;
    }
    .device-row .device-desktop,
    .device-row .device-cast {
      grid-column: span 3;
    }
    svg {
      height: 110px;
    }
    .device-cast svg {
      height: 96px;
    }
    li .viz-label span {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.is-playing) .ui .prog {
      animation: none;
    }
  }
</style>
