---
import { MIX } from "../../content/listen/viz";

const fade = ((MIX.fadeBars * 4 * 60) / MIX.bpm).toFixed(1);
const lufs = (value: number) => `−${Math.abs(value).toFixed(1)} LUFS`;
---

<figure class="mix" data-viz="mix" data-reveal aria-label={`Smart Mix transition: equal-power crossfade over ${MIX.fadeBars} bars at ${MIX.bpm} BPM`}>
  <header class="viz-bar" data-enter>
    <p class="viz-label"><b>Smart Mix</b> planned on the server · played on Android</p>
    <p class="viz-label">{MIX.bpm} BPM · {MIX.fadeBars} bars · {fade} s · equal power</p>
  </header>
  <div class="mix-stage">
    <svg class="mix-svg" aria-hidden="true"></svg>
    <p class="mix-tag a" aria-hidden="true">{MIX.a.label} · {MIX.a.key} · {lufs(MIX.a.lufs)}</p>
    <p class="mix-tag b" aria-hidden="true">{MIX.b.label} · {MIX.b.key} · {lufs(MIX.b.lufs)}</p>
  </div>
  <div class="mix-readout">
    <div class="meter">
      <span>A</span><i><b data-gain-bar="a"></b></i><output data-gain="a">1.00</output>
    </div>
    <div class="meter">
      <span>B</span><i><b data-gain-bar="b"></b></i><output data-gain="b">0.00</output>
    </div>
    <ul class="mix-facts viz-label">
      <li>Camelot <b>{MIX.a.key} → {MIX.b.key}</b></li>
      <li>Loudness <b>BS.1770</b></li>
      <li><b>Beat grid</b></li>
      <li>Range <b>0–12 s</b></li>
    </ul>
  </div>
</figure>

<style>
  .mix {
    margin: 0;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .mix-stage {
    position: relative;
    height: clamp(280px, 40vh, 380px);
    margin-top: 26px;
  }

  .mix-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .mix-svg :global(.mix-zone rect) {
    fill: rgba(6, 182, 212, 0.05);
  }

  .mix-svg :global(.mix-ticks line) {
    stroke: rgba(241, 245, 249, 0.2);
    stroke-width: 1;
  }

  .mix-svg :global(.mix-ticks line.down) {
    stroke: rgba(103, 232, 249, 0.6);
  }

  .mix-svg :global(.mix-wave.dim) {
    fill: rgba(241, 245, 249, 0.1);
  }

  .mix-svg :global(.mix-wave.lit) {
    fill: var(--cyan-hi);
  }

  .mix-svg :global(.mix-curves path) {
    fill: none;
    stroke: var(--fg);
    stroke-width: 2;
  }

  .mix-svg :global(.mix-curves path.dim) {
    stroke: rgba(241, 245, 249, 0.22);
    stroke-width: 1.25;
    stroke-dasharray: 3 4;
  }

  .mix-svg :global(.mix-curves .cross) {
    fill: var(--bg);
    stroke: var(--fg);
    stroke-width: 1.25;
  }

  .mix-svg :global(.mix-markers line) {
    stroke: rgba(241, 245, 249, 0.45);
    stroke-width: 1;
  }

  .mix-svg :global(.mix-text) {
    fill: var(--fg-2);
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .mix-svg :global(.mix-text.lower) {
    text-transform: none;
    letter-spacing: 0.06em;
  }

  .mix-svg :global(.mix-head) {
    stroke: var(--fg);
    stroke-width: 1;
  }

  .mix-svg :global(.mix-dot) {
    fill: var(--bg);
    stroke: var(--cyan-hi);
    stroke-width: 2;
    transition: opacity 0.2s linear;
  }

  .mix-tag {
    position: absolute;
    right: 0;
    margin: 0;
    padding: 2px 0 2px 10px;
    background: var(--bg);
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-2);
  }

  .mix-tag.a {
    top: 0;
  }

  .mix-tag.b {
    bottom: 0;
  }

  .mix-readout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 18px 40px;
    align-items: center;
    margin-top: 26px;
  }

  .meter {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) 5ch;
    gap: 14px;
    align-items: center;
    font-family: var(--mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--fg-2);
  }

  .meter i {
    height: 2px;
    background: var(--line);
  }

  .meter b {
    display: block;
    height: 100%;
    background: var(--cyan-hi);
    transform-origin: left;
    transform: scaleX(0);
  }

  .meter output {
    color: var(--fg);
    text-align: right;
  }

  .mix-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mix-facts b {
    font-weight: 400;
    color: var(--fg);
  }

  @media (max-width: 1000px) {
    .mix-readout {
      grid-template-columns: 1fr 1fr;
    }
    .mix-facts {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 760px) {
    .mix-readout {
      grid-template-columns: 1fr;
    }
    .mix-stage {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: 330px;
    }
    .mix-svg {
      inset: 28px 0;
      height: calc(100% - 56px);
    }
    .mix-tag {
      position: static;
      padding: 0;
      font-size: 9px;
    }
    .mix-svg :global(.mix-text) {
      font-size: 9px;
    }
  }
</style>
