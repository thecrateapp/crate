---
import { STACK_MAP } from "../../content/admin/observability";

const { image } = STACK_MAP;
const srcset = STACK_MAP.widths.map((width) => `${image.image}-${width}.webp ${width}w`).join(", ");
---

<figure class="stackmap" data-viz="stack-map" data-reveal>
  <header class="viz-bar" data-enter>
    <p class="viz-label"><b>{STACK_MAP.label}</b> {STACK_MAP.host}</p>
    <p class="viz-label sample">{STACK_MAP.sample}</p>
  </header>

  <div class="shot" style={`aspect-ratio:${image.width} / ${image.height}`}>
    <img
      srcset={srcset}
      sizes={STACK_MAP.sizes}
      src={`${image.image}-1440.webp`}
      width={image.width}
      height={image.height}
      alt={image.alt}
      loading="lazy"
      decoding="async"
    />
    <video muted loop playsinline preload="none" disablepictureinpicture poster={`${image.image}-1440.webp`} aria-hidden="true" tabindex="-1">
      <source src={`${STACK_MAP.video}.webm`} type="video/webm" />
      <source src={`${STACK_MAP.video}.mp4`} type="video/mp4" />
    </video>
  </div>

  <figcaption>{STACK_MAP.caption}</figcaption>
</figure>

<style>
  .stackmap {
    display: grid;
    gap: 18px;
    margin: 0;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .sample {
    color: var(--amber);
  }

  .shot {
    position: relative;
  }

  .shot img,
  .shot video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shot video {
    opacity: 0;
    transition: opacity 0.4s var(--ease-snap);
  }

  .shot:global(.is-video) video {
    opacity: 1;
  }

  figcaption {
    max-width: 72ch;
    color: var(--fg-3);
    font-family: var(--mono);
    font-size: 11.5px;
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .shot video {
      display: none;
    }
  }
</style>
