---
import type { Endpoint } from "../../content/developers/en";

interface Props {
  items: Endpoint[];
}

const { items } = Astro.props;
---

<ul class="endpoints" data-reveal>
  {
    items.map((item, index) => (
      <li style={`--i:${index}`}>
        <code>
          <b class={item.method.toLowerCase()}>{item.method}</b> {item.path}
        </code>
        <p>{item.body}</p>
      </li>
    ))
  }
</ul>

<style>
  .endpoints {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 12px clamp(24px, 5vw, 80px);
    padding: 26px 0 30px;
    border-top: 1px solid var(--line);
  }

  :global(:where(html.js)) li {
    opacity: 0;
  }

  .is-in li {
    animation: enter-up 0.7s var(--spring-snappy) both;
    animation-delay: calc(var(--i, 0) * 70ms);
  }

  code {
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.6;
    color: var(--fg);
    overflow-wrap: anywhere;
  }

  b {
    display: inline-block;
    margin-right: 10px;
    padding: 1px 7px;
    border: 1px solid rgba(103, 232, 249, 0.45);
    border-radius: 4px;
    font-size: 10.5px;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--cyan-hi);
    vertical-align: 1px;
  }

  b.post {
    border-color: var(--cyan-hi);
    background: var(--cyan-hi);
    color: var(--bg);
  }

  p {
    margin: 0;
    max-width: 60ch;
    font-size: clamp(0.98rem, 1.1vw, 1.08rem);
    line-height: 1.7;
    color: var(--fg-2);
  }

  @media (max-width: 760px) {
    li {
      grid-template-columns: 1fr;
      padding: 22px 0 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-in li {
      animation: fade-in 0.3s linear both;
    }
  }
</style>
