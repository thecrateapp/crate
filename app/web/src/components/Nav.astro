---
import { t } from "../i18n";
import SiteNav from "./nav/SiteNav.astro";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;

const links = [
  { href: "/why", label: t("nav.manifesto", locale) },
  { href: "/listen", label: t("nav.listen", locale) },
  { href: "/admin", label: t("nav.admin", locale) },
  { href: "/architecture", label: t("nav.architecture", locale) },
  { href: "/developers", label: t("nav.developers", locale) },
  { href: "/blog", label: t("nav.blog", locale) },
  { href: "/install", label: t("nav.install", locale), accent: true },
  { href: "https://docs.cratemusic.app", label: t("nav.docs", locale) },
  { href: "https://github.com/thecrateapp/crate", label: t("nav.github", locale) },
];
---

<SiteNav
  brand={{ href: "/", label: "Crate" }}
  links={links}
  menu={t("nav.menu", locale)}
  close={t("nav.close", locale)}
/>
