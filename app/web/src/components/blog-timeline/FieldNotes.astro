---
import { milestones } from "../../data/engineering-timeline";
import BlogIcon from "../BlogIcon.astro";

const eras = [...new Set(milestones.map((milestone) => milestone.era))].map(
  (era) => ({
    name: era,
    index: milestones.findIndex((milestone) => milestone.era === era),
    count: milestones.filter((milestone) => milestone.era === era).length,
  }),
);
const first = milestones[0];
const last = milestones[milestones.length - 1];
const formatDate = (date: string) =>
  new Intl.DateTimeFormat("en", {
    day: "2-digit",
    month: "short",
    timeZone: "UTC",
  }).format(new Date(`${date}T12:00:00Z`));
const formatMonth = (date: string) =>
  new Intl.DateTimeFormat("en", {
    month: "long",
    timeZone: "UTC",
  }).format(new Date(`${date}T12:00:00Z`));
const statusLabel = (status: string) =>
  status === "draft" ? "Draft article" : status === "available" ? "Article available" : "Article planned";
---

<section
  class="field-notes"
  data-timeline-proposal="field-notes"
  aria-labelledby="field-notes-title"
>
  <header class="field-heading">
    <div>
      <p class="field-kicker">Engineering / Field notes</p>
      <h2 id="field-notes-title">The decisions behind Crate.</h2>
    </div>
    <p class="field-intro">
      Follow the problems as they appeared. Open a milestone to see what changed
      and read the engineering behind it.
    </p>
  </header>

  <div class="field-layout">
    <aside class="field-index" aria-label="Timeline navigation">
      <div class="field-year">
        <span class="field-kicker">Development log</span>
        <strong>{first?.date.slice(0, 4)}</strong>
        {first && last && <span class="field-months">{formatMonth(first.date)} to {formatMonth(last.date)}</span>}
      </div>

      <nav class="field-eras" data-note-era-nav aria-label="Jump to a development period">
        {eras.map((era, index) => (
          <button
            type="button"
            data-era-index={era.index}
            aria-pressed={index === 0 ? "true" : "false"}
            aria-label={`Jump to ${era.name}`}
          >
            <span class="era-number">{String(index + 1).padStart(2, "0")}</span>
            <span>{era.name}</span>
            <span class="era-count">{String(era.count).padStart(2, "0")}</span>
          </button>
        ))}
      </nav>

      <div class="field-controls">
        <p class="field-position" aria-live="polite" aria-atomic="true">
          <span data-note-position>01</span>
          <span class="position-total">/ {String(milestones.length).padStart(2, "0")}</span>
        </p>
        <div class="field-step-buttons">
          <button type="button" data-note-previous aria-label="Previous milestone" disabled>
            <BlogIcon name="arrow-up" />
          </button>
          <button type="button" data-note-next aria-label="Next milestone" disabled={milestones.length < 2}>
            <BlogIcon name="arrow-down" />
          </button>
        </div>
      </div>
      <p class="field-instruction">Choose an entry, or use the arrow keys.</p>
    </aside>

    <ol class="field-entries" data-note-entries>
      {milestones.map((milestone, index) => (
        <li
          class:list={["field-entry", { "is-selected": index === 0 }]}
          data-milestone-id={milestone.id}
          data-note-era={milestone.era}
          id={`field-note-${milestone.id}`}
        >
          <time class="entry-date" datetime={milestone.date}>
            <span>{formatDate(milestone.date)}</span>
            <span class="entry-number">{String(index + 1).padStart(2, "0")}</span>
          </time>
          <span class="entry-marker" aria-hidden="true" />
          <div class="entry-content">
            <h3>
              <button
                type="button"
                class="entry-select"
                data-note-select={index}
                aria-pressed={index === 0 ? "true" : "false"}
                aria-expanded="true"
                aria-controls={`field-note-detail-${milestone.id}`}
                aria-label={`Select milestone: ${milestone.title}`}
              >
                <span>{milestone.title}</span>
                <span class="entry-toggle" aria-hidden="true"><BlogIcon name="chevron-down" /></span>
              </button>
            </h3>
            <p class="entry-summary">{milestone.summary}</p>
            <div class="entry-detail" id={`field-note-detail-${milestone.id}`} data-note-detail>
              <div class="entry-change">
                <p class="field-kicker">What changed</p>
                <p>{milestone.change}</p>
              </div>
              <ul class="entry-systems" aria-label="Systems involved">
                {milestone.systems.map((system) => <li>{system}</li>)}
              </ul>
              <div class="entry-footer">
                <div class="entry-reading">
                  <span class:list={["entry-status", { "is-draft": milestone.status === "draft" }]}>
                    {statusLabel(milestone.status)}
                    {milestone.chapter != null && <span> · Chapter {milestone.chapter}</span>}
                  </span>
                  {milestone.href && (
                    <a class="entry-article" href={milestone.href}>
                      {milestone.status === "draft" ? "Read the draft" : "Read related post"}
                      <BlogIcon name="arrow-right" size={16} />
                    </a>
                  )}
                </div>
                {/^https?:\/\//.test(milestone.source) && (
                  <a class="entry-source" href={milestone.source} data-blog-link="github">
                    <BlogIcon name="github" size={16} /> Source
                  </a>
                )}
              </div>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  import { mountOnPage } from "../../scripts/motion/page";
  import { initFieldNotes } from "../../scripts/blog-timeline/field-notes";

  mountOnPage('[data-timeline-proposal="field-notes"]', initFieldNotes);
</script>

<style>
  .field-notes {
    --date-width: 76px;
    --spine-gap: 30px;
    --spine-x: calc(var(--date-width) + 13px);
    max-width: 1320px;
    margin: 0 auto;
    padding: 56px clamp(20px, 5vw, 76px) 100px;
  }

  .field-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(260px, 0.8fr);
    align-items: end;
    gap: 32px;
    margin-bottom: 72px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--line);
  }

  .field-kicker {
    margin: 0;
    color: var(--fg-3);
    font: 400 10px/1.5 var(--mono);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .field-heading .field-kicker {
    margin-bottom: 18px;
    color: var(--cyan-hi);
  }

  h2 {
    max-width: 16ch;
    margin: 0;
    font: 600 clamp(2rem, 4vw, 3.5rem)/1.02 var(--display);
    letter-spacing: -0.045em;
  }

  .field-intro {
    max-width: 37ch;
    margin: 0 0 3px;
    color: var(--fg-2);
    font-size: 15px;
    line-height: 1.7;
  }

  .field-layout {
    display: grid;
    grid-template-columns: 205px minmax(0, 1fr);
    align-items: start;
    gap: clamp(36px, 6vw, 88px);
  }

  .field-index {
    position: sticky;
    top: 112px;
    display: flex;
    flex-direction: column;
    max-height: calc(100svh - 144px);
  }

  .field-year {
    display: grid;
    gap: 10px;
    flex-shrink: 0;
  }

  .field-year strong {
    font: 600 clamp(4rem, 6.5vw, 6.2rem)/0.95 var(--display);
    letter-spacing: -0.07em;
    font-variant-numeric: tabular-nums;
  }

  .field-months {
    color: var(--fg-2);
    font-size: 12px;
  }

  .field-eras {
    display: grid;
    min-height: 48px;
    margin-top: 32px;
    border-top: 1px solid var(--line);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }

  button {
    appearance: none;
    border: 0;
    border-radius: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    text-align: left;
  }

  .field-eras button {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) 20px;
    align-items: start;
    gap: 10px;
    min-height: 48px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    color: var(--fg-2);
    font: 400 12px/1.5 var(--sans);
    transition: color 160ms ease;
  }

  .field-eras button[aria-pressed="true"],
  .field-eras button:hover {
    color: var(--cyan-hi);
  }

  .era-number,
  .era-count {
    padding-top: 2px;
    font: 400 9px/1.5 var(--mono);
    font-variant-numeric: tabular-nums;
  }

  .era-count {
    color: var(--fg-3);
    text-align: right;
  }

  .field-controls {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 25px;
  }

  .field-position {
    display: flex;
    gap: 8px;
    margin: 0;
    font: 400 12px/1.5 var(--mono);
    color: var(--cyan-hi);
    font-variant-numeric: tabular-nums;
  }

  .position-total {
    color: var(--fg-3);
  }

  .field-step-buttons {
    display: flex;
    gap: 4px;
  }

  .field-step-buttons button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-size: 18px;
  }

  .field-step-buttons button:hover:not(:disabled) {
    border-color: var(--cyan);
    color: var(--cyan-hi);
  }

  .field-step-buttons button:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .field-instruction {
    flex-shrink: 0;
    max-width: 22ch;
    margin: 14px 0 0;
    font-size: 11px;
    line-height: 1.6;
    color: var(--fg-3);
  }

  .field-entries {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    isolation: isolate;
  }

  .field-entries::before,
  .field-entries::after {
    content: "";
    position: absolute;
    z-index: -1;
    left: var(--spine-x);
    top: 18px;
    bottom: 28px;
    width: 1px;
    background: var(--line);
  }

  .field-entries::after {
    background: var(--cyan);
    transform: scaleY(var(--note-progress, 0));
    transform-origin: top;
  }

  .field-entry {
    display: grid;
    grid-template-columns: var(--date-width) var(--spine-gap) minmax(0, 1fr);
    position: relative;
    padding-bottom: 28px;
    scroll-margin-top: 128px;
    transition: opacity 220ms ease;
  }

  .field-notes[data-enhanced] .field-entry:not([data-seen]):not(.is-selected) {
    opacity: 1;
  }

  .entry-date {
    display: grid;
    align-content: start;
    gap: 7px;
    padding-top: 13px;
    color: var(--fg-2);
    font: 400 10px/1.4 var(--mono);
    letter-spacing: 0.015em;
  }

  .entry-number {
    color: var(--fg-3);
    font-size: 9px;
  }

  .entry-marker {
    position: relative;
    left: 9px;
    top: 15px;
    width: 9px;
    height: 9px;
    border: 1px solid var(--fg-3);
    border-radius: 50%;
    background: var(--bg);
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .is-selected .entry-marker {
    border-color: var(--cyan-hi);
    background: var(--cyan-hi);
    box-shadow: 0 0 0 5px rgb(103 232 249 / 0.09);
  }

  .is-selected .entry-date {
    color: var(--cyan-hi);
  }

  .entry-content {
    min-width: 0;
    padding-bottom: 26px;
    border-bottom: 1px solid var(--line);
  }

  h3 {
    margin: 0;
    font: 500 clamp(1.25rem, 1.8vw, 1.65rem)/1.15 var(--display);
    letter-spacing: -0.025em;
  }

  .entry-select {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    min-height: 44px;
    padding: 8px 0 10px;
    font: inherit;
    letter-spacing: inherit;
    transition: color 160ms ease;
  }

  .entry-select:hover,
  .entry-select[aria-pressed="true"] {
    color: var(--cyan-hi);
  }

  .entry-toggle {
    flex: 0 0 18px;
    padding-top: 2px;
    color: var(--fg-3);
    font: 400 16px/1 var(--mono);
    transition: transform 160ms ease;
  }

  .entry-select[aria-pressed="true"] .entry-toggle {
    color: var(--cyan-hi);
    transform:rotate(180deg);
  }

  .entry-summary {
    max-width: 58ch;
    margin: 1px 28px 0 0;
    color: var(--fg-2);
    font-size: 13px;
    line-height: 1.65;
  }

  .entry-detail {
    padding-top: 26px;
  }

  .entry-detail[hidden] {
    display: none;
  }

  .entry-change {
    max-width: 58ch;
    padding-left: 18px;
    border-left: 1px solid var(--cyan);
  }

  .entry-change .field-kicker {
    color: var(--cyan-hi);
    font-size: 9px;
  }

  .entry-change > p:last-child {
    margin: 9px 0 0;
    font-size: 15px;
    line-height: 1.75;
  }

  .entry-systems {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 14px;
    margin: 21px 0 0;
    padding: 0;
    color: var(--fg-3);
    list-style: none;
    font: 400 10px/1.6 var(--mono);
  }

  .entry-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 25px;
  }

  .entry-reading {
    display: grid;
    gap: 4px;
  }

  .entry-status {
    color: var(--fg-3);
    font: 400 10px/1.6 var(--mono);
  }

  .entry-status.is-draft {
    color: var(--amber);
  }

  .entry-article,
  .entry-source {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    min-height: 44px;
    text-decoration: none;
    text-underline-offset: 5px;
  }

  .entry-article {
    color: var(--cyan-hi);
    font-size: 13px;
  }

  .entry-source {
    color: var(--fg-3);
    font: 400 10px/1.6 var(--mono);
  }

  .entry-article:hover,
  .entry-source:hover {
    text-decoration: underline;
  }

  @media (max-width: 1000px) {
    .field-layout {
      grid-template-columns: 170px minmax(0, 1fr);
      gap: 34px;
    }
  }

  @media (max-width: 760px) {
    .field-notes {
      --date-width: 53px;
      --spine-gap: 26px;
      --spine-x: calc(var(--date-width) + 10px);
      padding-top: 36px;
    }

    .field-heading {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 32px;
    }

    .field-intro {
      max-width: 44ch;
      font-size: 14px;
    }

    .field-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }

    .field-index {
      position: static;
      display: grid;
      max-height: none;
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 20px;
    }

    .field-year {
      gap: 7px;
    }

    .field-year strong {
      font-size: 3.5rem;
    }

    .field-year .field-kicker,
    .field-instruction {
      display: none;
    }

    .field-controls {
      grid-column: 2;
      grid-row: 1;
      gap: 16px;
      margin-top: 0;
    }

    .field-eras {
      display: flex;
      grid-column: 1 / -1;
      gap: 22px;
      overflow-x: auto;
      overflow-y: hidden;
      margin: 2px 0 0;
      border-bottom: 1px solid var(--line);
      scrollbar-width: thin;
    }

    .field-eras button {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      gap: 9px;
      max-width: 190px;
      border-bottom: 0;
      font-size: 11px;
    }

    .era-count {
      display: none;
    }

    .entry-marker {
      left: 6px;
    }

    .entry-date {
      font-size: 9px;
    }

    .entry-summary {
      margin-right: 0;
      font-size: 12px;
    }

    .entry-select {
      gap: 10px;
    }

    .entry-change {
      padding-left: 12px;
    }

    .entry-change > p:last-child {
      font-size: 14px;
      line-height: 1.7;
    }

    .entry-footer {
      gap: 4px 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field-entry,
    .entry-marker,
    .entry-select,
    .entry-toggle,
    .field-eras button {
      transition: none;
    }
  }
</style>
