---
import { postTags } from "../lib/blog-tags";

interface Props {
  tags: string[];
  counts?: Record<string, number>;
  current?: string;
  label?: string;
}
const { tags, counts, current, label = "Post topics" } = Astro.props;
const topics = postTags(tags);
---

{topics.length > 0 && (
  <nav class="blog-tags" aria-label={label} data-blog-tags>
    <ul>
      {topics.map((tag) => (
        <li>
          <a
            href={tag.href}
            class="blog-tag"
            data-slot="chip"
            data-state={current === tag.slug ? "active" : "inactive"}
            aria-current={current === tag.slug ? "page" : undefined}
            rel="tag"
          >
            {tag.label}
            {counts?.[tag.key] !== undefined && <span class="count">{counts[tag.key]}<span class="sr-only"> {counts[tag.key] === 1 ? "post" : "posts"}</span></span>}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  /* The @crate/ui FilterChip recipe, rendered as a navigation link in Astro.
     Navigation is not a toggle and needs no React island or aria-pressed state. */
  .blog-tags { margin-top:24px; }
  ul { display:flex; flex-wrap:wrap; gap:10px 8px; margin:0; padding:0; list-style:none; }
  li { min-width:0; max-width:100%; }
  .blog-tag { position:relative; display:inline-flex; align-items:center; justify-content:center; gap:6px; min-height:32px; max-width:100%; padding:4px 12px; border:1px solid var(--line); border-radius:9999px; color:var(--fg-2); background:transparent; font:400 12px/16px var(--mono); letter-spacing:.04em; text-transform:none; text-decoration:none; overflow-wrap:anywhere; transition:background-color 150ms ease,border-color 150ms ease,color 150ms ease; }
  .blog-tag:hover { border-color:color-mix(in srgb,var(--cyan-hi) 40%,transparent); color:var(--fg); }
  .blog-tag:focus-visible { outline:2px solid var(--cyan-hi); outline-offset:4px; }
  .blog-tag[data-state="active"] { border-color:var(--cyan-hi); background:var(--cyan-hi); color:var(--bg); }
  .count { flex-shrink:0; padding-left:7px; margin-left:2px; border-left:1px solid var(--line); color:var(--cyan-hi); font-variant-numeric:tabular-nums; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  @media(pointer:coarse) {
    ul { gap:14px 10px; }
    .blog-tag::after { content:""; position:absolute; top:50%; left:50%; width:max(100%,44px); height:44px; transform:translate(-50%,-50%); }
  }
  @media(prefers-reduced-motion:reduce) { .blog-tag { transition:none; } }
</style>
