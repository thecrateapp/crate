---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { t } from "../i18n";
import ScreencastFrame from "./screencast/Screencast.astro";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const asset = (file: string) => (existsSync(join(process.cwd(), "public", file)) ? file : undefined);
const chapters = (["library", "player", "radio", "paths", "offline"] as const).map((id, index) => ({
  id,
  number: `0${index + 1}`,
  title: t(`screencast.${id}`, locale),
  poster: asset(`/screencast/${id}.jpg`),
  webm: asset(`/screencast/${id}.webm`),
  mp4: asset(`/screencast/${id}.mp4`),
}));
---

<ScreencastFrame
  chapters={chapters}
  label={t("screencast.label", locale)}
  play={t("screencast.play", locale)}
  pause={t("screencast.pause", locale)}
/>
