---
import { t } from "../i18n";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const rows = [t("statement.1", locale), t("statement.2", locale), t("statement.3", locale)];
---

<section class="statement">
  {
    rows.map((text) => (
      <div class="row" data-reveal>
        <p data-split style="--step:14ms" set:html={text} />
      </div>
    ))
  }
</section>
