---
import Explore from "../components/Explore.astro";
import GetCrate from "../components/GetCrate.astro";
import Hero from "../components/Hero.astro";
import Screencast from "../components/Screencast.astro";
import Statement from "../components/Statement.astro";
import Base from "../layouts/Base.astro";
---

<Base
  title="Crate — not a streaming service"
  description="Crate is free, open-source, self-hosted music software. Own your music. Support your artists. Refuse the middleman."
>
  <Hero />
  <Statement />
  <Screencast />
  <GetCrate />
  <Explore />
</Base>

<script>
  import { initReveals } from "../scripts/motion/reveal";
  import { initSmoothScroll } from "../scripts/motion/smooth-scroll";
  import { splitWords } from "../scripts/motion/split-words";

  let cleanups: (() => void)[] = [];

  function teardown() {
    cleanups.forEach((cleanup) => cleanup());
    cleanups = [];
  }

  document.addEventListener("astro:page-load", () => {
    teardown();
    if (!document.querySelector(".hero-pin")) return;
    document.querySelectorAll<HTMLElement>(".statement [data-split]").forEach((element) => {
      if (!element.querySelector(".w")) splitWords(element);
    });
    cleanups = [initSmoothScroll(), initReveals()];
  });

  document.addEventListener("astro:before-swap", teardown);
</script>
