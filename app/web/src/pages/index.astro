---
import Explore from "../components/Explore.astro";
import GetCrate from "../components/GetCrate.astro";
import Hero from "../components/Hero.astro";
import Screencast from "../components/Screencast.astro";
import Statement from "../components/Statement.astro";
import Base from "../layouts/Base.astro";
---

<Base
  title="Crate — not a streaming service"
  description="Crate is free, open-source, self-hosted music software. Own your music. Support your artists. Refuse the middleman."
>
  <Hero />
  <Statement />
  <Screencast />
  <GetCrate />
  <Explore />
</Base>

<script>
  import { mountOnPage } from "../scripts/motion/page";
  import { initTextMotion } from "../scripts/motion/text-motion";

  mountOnPage(".hero-pin", () => initTextMotion(".statement [data-split]"));
</script>
