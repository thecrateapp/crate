---
import { getEntry, render } from "astro:content";
import { t } from "../i18n";
import Base from "../layouts/Base.astro";

const entry = await getEntry("manifesto", "en");
if (!entry) throw new Error("Missing manifesto entry for en");
const { Content } = await render(entry);
---

<Base title={`${entry.data.title} — Crate`} description={entry.data.description}>
  <article class="why">
    <header class="why-head" data-reveal>
      <a class="u-link back" href="/" data-enter>&larr; {t("page.back")}</a>
      <p class="eyebrow" data-enter style="--d:80ms">{t("why.eyebrow")}</p>
      <h1 class="display" data-split style="--d:120ms;--step:60ms">{entry.data.title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<script>
  import { mountOnPage } from "../scripts/motion/page";
  import { initTextMotion } from "../scripts/motion/text-motion";

  mountOnPage(".why", () => {
    document.querySelectorAll<HTMLElement>(".why .prose .em").forEach((element) => {
      element.dataset.split = "";
      element.dataset.reveal = "";
      element.style.setProperty("--step", "18ms");
    });
    return initTextMotion();
  });
</script>

<style>
  .why {
    position: relative;
    z-index: 5;
    max-width: 1320px;
    margin: 0 auto;
    padding: 20vh clamp(20px, 6vw, 96px) 14vh;
  }

  .why-head {
    display: grid;
    gap: 26px;
    margin-bottom: 12vh;
  }

  .back {
    justify-self: start;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .why-head .display {
    font-size: clamp(3.2rem, 10vw, 10rem);
    max-width: 9ch;
  }

  .prose {
    max-width: 68ch;
    margin-left: clamp(0px, 14vw, 240px);
    font-size: clamp(1.0625rem, 1.25vw, 1.25rem);
    line-height: 1.75;
    color: var(--fg-2);
  }

  .prose :global(p) {
    margin: 0 0 1.5em;
  }

  .prose :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }

  .prose :global(.em) {
    margin: 2.2em 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.6rem, 3vw, 2.75rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--fg);
    text-wrap: pretty;
  }

  .prose :global(.em:last-child) {
    margin-bottom: 0;
    color: var(--cyan-hi);
  }

  @media (max-width: 760px) {
    .why {
      padding-top: 16vh;
    }
    .prose {
      margin-left: 0;
    }
  }
</style>
