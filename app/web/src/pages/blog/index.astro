---
import { getCollection } from "astro:content";
import PageHeader from "../../components/PageHeader.astro";
import { t } from "../../i18n";
import Base from "../../layouts/Base.astro";
import {
  formatPostDate,
  postUrl,
  publishedPosts,
  readingMinutes,
} from "../../lib/blog";

const posts = publishedPosts(await getCollection("blog"), {
  includeDrafts: import.meta.env.DEV,
});
---

<Base title={`${t("blog.title")} · Crate`} description={t("blog.lede")}>
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    title={t("blog.title")}
    href="/blog/rss.xml"
  />
  <PageHeader
    eyebrow={t("blog.eyebrow")}
    title={t("blog.title")}
    lede={t("blog.lede")}
  >
    <a class="u-link rss" href="/blog/rss.xml">{t("blog.rss")}</a>
  </PageHeader>

  <section class="posts" aria-label={t("blog.title")}>
    {
      posts.length === 0 ? (
        <p class="empty">{t("blog.empty")}</p>
      ) : (
        <ol>
          {posts.map((post) => (
            <li data-reveal>
              <a href={postUrl(post.id)}>
                <p class="meta">
                  <time datetime={formatPostDate(post.data.date)}>
                    {formatPostDate(post.data.date)}
                  </time>
                  <span aria-hidden="true">·</span>
                  {t("blog.minutes", "en", {
                    minutes: String(readingMinutes(post.body ?? "")),
                  })}
                  {post.data.tags.map((tag) => (
                    <>
                      <span aria-hidden="true">·</span>
                      {tag}
                    </>
                  ))}
                  {post.data.draft && <span class="draft">draft</span>}
                </p>
                <h2>{post.data.title}</h2>
                <p class="description">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </section>
</Base>

<style>
  .rss {
    justify-self: start;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .posts {
    position: relative;
    z-index: 5;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 clamp(20px, 6vw, 96px) 16vh;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  li {
    border-bottom: 1px solid var(--line);
  }

  li a {
    display: grid;
    gap: 12px;
    padding: clamp(28px, 4vw, 44px) 0;
    color: inherit;
    text-decoration: none;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .draft {
    color: var(--amber);
  }

  h2 {
    margin: 0;
    max-width: 24ch;
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.75rem, 3.2vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--fg);
    transition: color 200ms var(--ease-out);
  }

  li a:hover h2,
  li a:focus-visible h2 {
    color: var(--cyan-hi);
  }

  .description {
    margin: 0;
    max-width: 62ch;
    font-size: clamp(1rem, 1.1vw, 1.125rem);
    line-height: 1.6;
    color: var(--fg-2);
  }

  .empty {
    margin: 0;
    padding: 8vh 0;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
</style>
