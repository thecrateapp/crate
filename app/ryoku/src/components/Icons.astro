---
// crate-icons and crateize: every app on the desktop in Crate's icon language.
import { ICONS } from "../data/icons";

const RULES = [
  {
    label: "Solar glyphs",
    text: "System apps are drawn by hand from Solar's line-duotone set: white ink, one cyan layer.",
  },
  {
    label: "Brand marks",
    text: "Apps known by their logo wear their mark from Tabler Icons or Simple Icons, in Crate's colours.",
  },
  {
    label: "Graded fallback",
    text: "A brand with no free mark keeps its own icon, regraded so its brand colour becomes Crate cyan.",
  },
  {
    label: "Always current",
    text: "A watcher redraws the set when you install or remove an app. Papirus fills the rest.",
  },
];
---

<section id="icons" class="section" aria-labelledby="icons-title">
  <div class="head" data-reveal>
    <p class="eyebrow"><b>Icons</b> in Crate's language</p>
    <h2 id="icons-title" class="display">Every app, drawn the Crate way.</h2>
    <p class="lede">
      crate-icons draws the system apps, and crateize draws everything else you install, so the dock
      and the launcher read as one set.
    </p>
  </div>
  <ul class="icons" data-reveal aria-label="Icons from crate-icons">
    {
      ICONS.map((icon) => (
        <li data-kind={icon.kind}>
          <img src={icon.file} alt={icon.name} width="64" height="64" loading="lazy" decoding="async" />
          <span class="name" aria-hidden="true">
            {icon.name}
          </span>
        </li>
      ))
    }
  </ul>
  <ul class="rules" data-reveal>
    {
      RULES.map((rule) => (
        <li>
          <span class="label">{rule.label}</span>
          <span class="text">{rule.text}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .lede {
    margin: 0;
    max-width: 62ch;
    color: var(--fg-2);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.5;
  }

  /* Straight on the page, like the dock's icons on the wallpaper: no plate, no frames. */
  .icons {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(104px, 1fr));
    gap: 40px 16px;
    margin: 0 0 72px;
    padding: 0;
    list-style: none;
  }

  .icons li {
    display: grid;
    justify-items: center;
    gap: 14px;
  }

  .icons img {
    display: block;
    width: 64px;
    height: 64px;
  }

  .name {
    color: var(--fg-3);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-align: center;
    white-space: nowrap;
  }

  @media (max-width: 520px) {
    .icons {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px 8px;
    }

    .icons img {
      width: 56px;
      height: 56px;
    }
  }

  .rules {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rules li {
    display: grid;
    gap: 10px;
    padding: 20px 0 28px;
    border-top: 1px solid var(--line);
  }

  .label {
    color: var(--cyan-hi);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .text {
    color: var(--fg-2);
    line-height: 1.55;
  }
</style>
