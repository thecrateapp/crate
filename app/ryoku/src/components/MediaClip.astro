---
import type { Clip } from "../data/media";

interface Props {
  clip: Clip;
  loop?: boolean;
  autoplay?: boolean;
  class?: string;
}

const { clip, loop = true, autoplay = true, class: className } = Astro.props;
---

<figure class:list={["clip", className]} data-clip={clip.id} data-state="loading">
  <video
    muted
    playsinline
    preload="metadata"
    poster={clip.poster}
    loop={loop}
    data-autoplay={autoplay ? "" : undefined}
    aria-label={clip.title}
  >
    <source src={clip.webm} type="video/webm" />
    {clip.mp4 && <source src={clip.mp4} type="video/mp4" />}
  </video>
  <slot />
</figure>

<script>
  import { mountClips } from "../scripts/clips";
  import { mountOnPage } from "@crate-web/scripts/motion/page";

  mountOnPage("[data-clip]", mountClips);
</script>

<style>
  .clip {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: rgba(241, 245, 249, 0.02);
    aspect-ratio: 16 / 9;
  }

  .clip :global(video),
  .clip :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .clip[data-state="placeholder"] {
    background:
      linear-gradient(135deg, transparent 49.6%, var(--line) 50%, transparent 50.4%),
      rgba(241, 245, 249, 0.02);
  }
</style>
