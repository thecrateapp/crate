---
import Equalizer from "./play/Equalizer.astro";
import KitControls from "./play/KitControls.astro";
---

<section id="play" class="section" aria-labelledby="play-title">
  <header class="head" data-reveal>
    <p class="eyebrow"><b>Play</b> with it</p>
    <h2 id="play-title" class="display">Drag a band.</h2>
    <p class="intro">crate-mark's equalizer and Ryoku's kit, rebuilt for the web. On the desktop they drive Crate's real player.</p>
  </header>
  <div class="pieces">
    <div data-reveal><Equalizer /></div>
    <div data-reveal><KitControls /></div>
  </div>
</section>

<style>
  .intro {
    margin: 0;
    max-width: 52ch;
    color: var(--fg-2);
    line-height: 1.55;
  }

  .pieces {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 28px;
    align-items: start;
  }
</style>
