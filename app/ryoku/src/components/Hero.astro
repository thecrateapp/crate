---
import Showcase from "@crate-web/components/showcase/Showcase.astro";
import { SHOTS } from "../data/shots";
import HeroBackdrop from "./HeroBackdrop.astro";
---

<section id="hero" class="hero" aria-labelledby="hero-title">
  <HeroBackdrop />
  <div class="copy">
    <p class="eyebrow" data-reveal><b>A Ryoku mod</b> from the Crate project</p>
    <h1 id="hero-title" class="display" data-reveal>Crate for Ryoku</h1>
    <p class="line" data-reveal>An opinionated mod of Ryoku based on Crate's visual design.</p>
    <div class="actions" data-reveal>
      <a class="primary" href="#install">Install Crate for Ryoku</a>
      <a class="u-link" href="#what-is-crate">What is Crate?</a>
    </div>
  </div>
  <div id="screenshots" class="screenshots">
  <Showcase
    shots={SHOTS}
    label="Crate for Ryoku screenshots"
    position="{index} / {count}"
    previous="Previous screenshot"
    next="Next screenshot"
    pause="Pause the screenshots"
    play="Play the screenshots"
  />
  </div>
</section>

<style>
  .hero {
    position: relative;
  }

  /* Above the backdrop, which is positioned. */
  .screenshots {
    position: relative;
    z-index: 1;
  }

  .copy {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 22px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 22vh clamp(16px, 6vw, 96px) 6vh;
  }

  h1 {
    font-size: clamp(48px, 11vw, 148px);
  }

  .line {
    margin: 0;
    max-width: 30ch;
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(22px, 3.2vw, 38px);
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--fg-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
  }
</style>
