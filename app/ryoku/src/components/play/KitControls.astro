---
import { PRESETS } from "../../data/presets";
import Beam from "./Beam.astro";
---

<div class="kit" data-kit>
  <div class="row">
    <p class="eyebrow"><b>Presets</b></p>
    <div class="chips" role="radiogroup" aria-label="Equalizer preset">
      <button type="button" role="radio" aria-checked="true" data-chip="manual" tabindex="0">Manual</button>
      {
        PRESETS.map((preset) => (
          <button type="button" role="radio" aria-checked="false" data-chip={preset.id} data-gains={JSON.stringify(preset.gains)} tabindex="-1">
            {preset.label}
          </button>
        ))
      }
    </div>
  </div>
  <div class="row">
    <p class="eyebrow"><b>Beam</b></p>
    <Beam label="Kit Beam" class="kit-beam" />
    <div class="controls">
      <button type="button" class="switch" role="switch" aria-checked="true" aria-label="Beam" data-beam-toggle>
        <span></span>
      </button>
      <label class="speed">
        <span>Leg</span>
        <input type="range" min="400" max="1800" step="50" value="900" data-beam-leg aria-label="Beam leg length" />
        <output data-beam-leg-value>900 ms</output>
      </label>
    </div>
  </div>
</div>

<script>
  import { mountOnPage } from "@crate-web/scripts/motion/page";
  import { reducedMotion } from "@crate-web/scripts/motion/env";
  import { MANUAL_EVENT, PRESET_EVENT } from "../../data/presets";

  mountOnPage("[data-kit]", () => {
    const kit = document.querySelector<HTMLElement>("[data-kit]")!;
    const chips = [...kit.querySelectorAll<HTMLButtonElement>("[data-chip]")];
    const beam = kit.querySelector<HTMLElement>("[data-beam]")!;
    const toggle = kit.querySelector<HTMLButtonElement>("[data-beam-toggle]")!;
    const leg = kit.querySelector<HTMLInputElement>("[data-beam-leg]")!;
    const legValue = kit.querySelector<HTMLOutputElement>("[data-beam-leg-value]")!;

    const check = (chip: HTMLButtonElement) => {
      chips.forEach((other) => {
        const on = other === chip;
        other.setAttribute("aria-checked", String(on));
        other.tabIndex = on ? 0 : -1;
      });
    };
    const choose = (chip: HTMLButtonElement) => {
      check(chip);
      if (chip.dataset.gains) {
        document.dispatchEvent(new CustomEvent(PRESET_EVENT, { detail: JSON.parse(chip.dataset.gains) }));
      }
    };

    const onClick = (event: Event) => {
      const chip = (event.target as Element).closest<HTMLButtonElement>("[data-chip]");
      if (chip) choose(chip);
    };
    const onKey = (event: KeyboardEvent) => {
      const i = chips.indexOf(event.target as HTMLButtonElement);
      if (i < 0) return;
      const delta = event.key === "ArrowRight" || event.key === "ArrowDown" ? 1 : event.key === "ArrowLeft" || event.key === "ArrowUp" ? -1 : 0;
      if (!delta) return;
      const next = chips[(i + delta + chips.length) % chips.length];
      next.focus();
      choose(next);
      event.preventDefault();
    };
    const onManual = () => check(chips[0]);

    const still = reducedMotion();
    if (still) {
      toggle.setAttribute("aria-checked", "false");
      toggle.disabled = true;
    }
    const onToggle = () => {
      const on = toggle.getAttribute("aria-checked") !== "true";
      toggle.setAttribute("aria-checked", String(on));
      beam.dataset.running = String(on);
    };
    const onLeg = () => {
      beam.dataset.leg = leg.value;
      legValue.textContent = `${leg.value} ms`;
    };

    kit.addEventListener("click", onClick);
    kit.addEventListener("keydown", onKey);
    toggle.addEventListener("click", onToggle);
    leg.addEventListener("input", onLeg);
    document.addEventListener(MANUAL_EVENT, onManual);
    return () => {
      kit.removeEventListener("click", onClick);
      kit.removeEventListener("keydown", onKey);
      toggle.removeEventListener("click", onToggle);
      leg.removeEventListener("input", onLeg);
      document.removeEventListener(MANUAL_EVENT, onManual);
    };
  });
</script>

<style>
  .kit {
    display: grid;
    gap: 28px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: rgba(9, 16, 22, 0.6);
  }

  .row {
    display: grid;
    gap: 14px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  [data-chip] {
    padding: 7px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--fg-2);
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 0.2s var(--ease-snap), color 0.2s var(--ease-snap);
  }

  [data-chip][aria-checked="true"] {
    border-color: var(--cyan-hi);
    color: var(--cyan-hi);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }

  .switch {
    position: relative;
    width: 42px;
    height: 24px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
  }

  .switch span {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--fg-3);
    transition: transform 0.3s var(--spring-snappy), background-color 0.2s;
  }

  .switch[aria-checked="true"] {
    border-color: var(--cyan);
  }

  .switch[aria-checked="true"] span {
    transform: translateX(18px);
    background: var(--cyan-hi);
  }

  .switch:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .speed {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--fg-3);
    min-width: 0;
    flex: 1;
  }

  input[type="range"] {
    flex: 1;
    min-width: 0;
    accent-color: var(--cyan);
  }

  output {
    min-width: 7ch;
    color: var(--fg-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .switch span {
      transition: none;
    }
  }
</style>
