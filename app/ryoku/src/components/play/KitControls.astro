---
import { PRESETS } from "../../data/presets";
import Beam from "./Beam.astro";
---

<div class="kit" data-kit>
  <div class="row">
    <p class="eyebrow"><b>Presets</b></p>
    <div class="chips" role="radiogroup" aria-label="Equalizer preset">
      <button
        type="button"
        role="radio"
        aria-checked="true"
        data-state="active"
        class="crate-form-chip"
        data-chip="manual"
        tabindex="0">Manual</button
      >
      {
        PRESETS.map((preset) => (
          <button
            type="button"
            role="radio"
            aria-checked="false"
            data-state="inactive"
            class="crate-form-chip"
            data-chip={preset.id}
            data-gains={JSON.stringify(preset.gains)}
            tabindex="-1"
          >
            {preset.label}
          </button>
        ))
      }
    </div>
  </div>
  <div class="row">
    <p class="eyebrow"><b>Beam</b></p>
    <Beam label="Kit Beam" class="kit-beam" />
    <div class="controls">
      <button
        type="button"
        class="crate-form-switch"
        role="switch"
        aria-checked="true"
        data-state="checked"
        aria-label="Beam"
        data-beam-toggle
      >
        <span class="crate-form-switch-thumb" data-state="checked"></span>
      </button>
      <label class="speed">
        <span>Leg</span>
        <input
          type="range"
          class="crate-form-slider"
          min="400"
          max="1800"
          step="50"
          value="900"
          data-beam-leg
          aria-label="Beam leg length"
        />
        <output data-beam-leg-value>900 ms</output>
      </label>
    </div>
  </div>
</div>

<script>
  import { mountOnPage } from "@crate-web/scripts/motion/page";
  import { reducedMotion } from "@crate-web/scripts/motion/env";
  import { MANUAL_EVENT, PRESET_EVENT } from "../../data/presets";

  mountOnPage("[data-kit]", () => {
    const kit = document.querySelector<HTMLElement>("[data-kit]")!;
    const chips = [...kit.querySelectorAll<HTMLButtonElement>("[data-chip]")];
    const beam = kit.querySelector<HTMLElement>("[data-beam]")!;
    const toggle = kit.querySelector<HTMLButtonElement>("[data-beam-toggle]")!;
    const thumb = toggle.querySelector<HTMLElement>(".crate-form-switch-thumb")!;
    const leg = kit.querySelector<HTMLInputElement>("[data-beam-leg]")!;
    const legValue = kit.querySelector<HTMLOutputElement>("[data-beam-leg-value]")!;

    const check = (chip: HTMLButtonElement) => {
      chips.forEach((other) => {
        const on = other === chip;
        other.setAttribute("aria-checked", String(on));
        other.dataset.state = on ? "active" : "inactive";
        other.tabIndex = on ? 0 : -1;
      });
    };
    const choose = (chip: HTMLButtonElement) => {
      check(chip);
      if (chip.dataset.gains) {
        document.dispatchEvent(
          new CustomEvent(PRESET_EVENT, { detail: JSON.parse(chip.dataset.gains) }),
        );
      }
    };

    const onClick = (event: Event) => {
      const chip = (event.target as Element).closest<HTMLButtonElement>("[data-chip]");
      if (chip) choose(chip);
    };
    const onKey = (event: KeyboardEvent) => {
      const i = chips.indexOf(event.target as HTMLButtonElement);
      if (i < 0) return;
      const forward = event.key === "ArrowRight" || event.key === "ArrowDown";
      const back = event.key === "ArrowLeft" || event.key === "ArrowUp";
      if (!forward && !back) return;
      const next = chips[(i + (forward ? 1 : -1) + chips.length) % chips.length];
      next.focus();
      choose(next);
      event.preventDefault();
    };
    const onManual = () => check(chips[0]);

    const setSwitch = (on: boolean) => {
      const state = on ? "checked" : "unchecked";
      toggle.setAttribute("aria-checked", String(on));
      toggle.dataset.state = state;
      thumb.dataset.state = state;
      beam.dataset.running = String(on);
    };
    if (reducedMotion()) {
      setSwitch(false);
      toggle.disabled = true;
      leg.disabled = true;
    }
    const onToggle = () => setSwitch(toggle.getAttribute("aria-checked") !== "true");
    const onLeg = () => {
      beam.dataset.leg = leg.value;
      legValue.textContent = `${leg.value} ms`;
    };

    kit.addEventListener("click", onClick);
    kit.addEventListener("keydown", onKey);
    toggle.addEventListener("click", onToggle);
    leg.addEventListener("input", onLeg);
    document.addEventListener(MANUAL_EVENT, onManual);
    return () => {
      kit.removeEventListener("click", onClick);
      kit.removeEventListener("keydown", onKey);
      toggle.removeEventListener("click", onToggle);
      leg.removeEventListener("input", onLeg);
      document.removeEventListener(MANUAL_EVENT, onManual);
    };
  });
</script>

<style>
  .kit {
    display: grid;
    gap: 28px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: rgba(9, 16, 22, 0.6);
  }

  .row {
    display: grid;
    gap: 14px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }

  .speed {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 12px;
    min-width: 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--fg-3);
  }

  .speed :global(.crate-form-slider) {
    flex: 1;
  }

  output {
    min-width: 7ch;
    color: var(--fg-2);
    font-variant-numeric: tabular-nums;
  }
</style>
