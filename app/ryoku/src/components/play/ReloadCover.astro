---
import { MARK_PATH } from "../../data/mark";
import Beam from "./Beam.astro";
---

<div class="cover" data-reveal>
  <div class="mark" data-mark>
    <svg viewBox="0 0 1052 1120" role="img" aria-label="The Crate mark">
      <defs>
        <linearGradient id="cover-brand" x1="226.95" y1="-47.06" x2="815.94" y2="1204.54" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#67e8f9"></stop>
          <stop offset="1" stop-color="#0e7490"></stop>
        </linearGradient>
        <linearGradient id="cover-sheen" x1="0" y1="0" x2="1" y2="0" gradientUnits="objectBoundingBox">
          <stop offset="0.35" stop-color="#fff" stop-opacity="0"></stop>
          <stop offset="0.5" stop-color="#fff" stop-opacity="0.55"></stop>
          <stop offset="0.65" stop-color="#fff" stop-opacity="0"></stop>
        </linearGradient>
        <clipPath id="cover-clip"><path d={MARK_PATH}></path></clipPath>
      </defs>
      <path class="body" d={MARK_PATH} fill="url(#cover-brand)"></path>
      <g clip-path="url(#cover-clip)">
        <rect class="sheen" x="-1052" y="0" width="1052" height="1120" fill="url(#cover-sheen)"></rect>
      </g>
    </svg>
  </div>
  <Beam label="Loading" class="cover-beam" />
  <p class="eyebrow">Reloading the shell, the Crate way</p>
</div>

<style>
  .cover {
    display: grid;
    justify-items: center;
    gap: 36px;
    padding: 12vh 16px;
  }

  .mark {
    width: clamp(96px, 16vw, 168px);
    animation: breathe 3.2s ease-in-out infinite;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .sheen {
    animation: sheen 3.6s var(--ease-in-out) infinite;
  }

  .cover :global(.cover-beam) {
    width: min(260px, 70vw);
  }

  @keyframes breathe {
    0%,
    100% {
      filter: drop-shadow(0 0 6px rgba(6, 182, 212, 0.25));
    }
    50% {
      filter: drop-shadow(0 0 28px rgba(103, 232, 249, 0.6));
    }
  }

  @keyframes sheen {
    0% {
      transform: translateX(0);
    }
    60%,
    100% {
      transform: translateX(2104px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mark,
    .sheen {
      animation: none;
    }

    .mark {
      filter: drop-shadow(0 0 16px rgba(103, 232, 249, 0.4));
    }
  }
</style>
