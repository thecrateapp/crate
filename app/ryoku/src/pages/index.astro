---
import Hero from "../components/Hero.astro";
import Install from "../components/Install.astro";
import PoweredByCrate from "../components/PoweredByCrate.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Surfaces from "../components/Surfaces.astro";
import Site from "../layouts/Site.astro";
---

<Site
  title="Crate for Ryoku"
  description="An opinionated mod of Ryoku based on Crate's visual design."
>
  <Hero />
  <section id="cover" aria-label="The reload cover"></section>
  <Surfaces />
  <section id="play" aria-label="Play with it"></section>
  <PoweredByCrate />
  <Install />
  <SiteFooter slot="after" />
</Site>
