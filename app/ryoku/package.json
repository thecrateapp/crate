{
  "name": "crate-ryoku-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-web-assets.mjs",
    "dev": "astro dev --port 5177 --host",
    "prebuild": "node scripts/sync-web-assets.mjs",
    "build": "astro check && astro build",
    "preview": "astro preview --port 5177",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "budget": "node ../web/scripts/check-budget.mjs dist 122880"
  },
  "dependencies": {
    "astro": "^7.4.12",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
