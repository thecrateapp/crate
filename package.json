{
  "name": "crate",
  "private": true,
  "scripts": {
    "design-system:drift": "node scripts/design-system/drift-inventory.mjs",
    "design-system:layers": "node scripts/design-system/layer-inventory.mjs",
    "design-system:tokens:check": "npm run --workspace=app/shared/ui test -- lib/appearance-theme-css.test.ts",
    "design-system:tokens:generate": "CRATE_UPDATE_THEME_TOKENS=1 npm run --workspace=app/shared/ui test -- lib/appearance-theme-css.test.ts",
    "test:appearance": "playwright test --config=playwright.appearance.config.ts"
  },
  "workspaces": [
    "app/shared/ui",
    "app/ui",
    "app/listen",
    "app/listen-desktop"
  ],
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.6"
  }
}
